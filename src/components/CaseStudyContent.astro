---
import TechPill from "@/components/TechPill.astro";
import OrgLogo from "@/components/OrgLogo.astro";
import type { OrgLogo as OrgLogoType } from "@/data/profile";
import { getAllProjects, formatDate, type ProjectView } from "@/lib/projects";

interface Props {
  project: ProjectView;
  /** When set, render `<slot name="after-section" />` immediately after this section's id. */
  insertAfterSectionId?: string;
  /** Optional client logo linking to their live site (case study header). */
  clientBranding?: {
    href?: string;
    name: string;
    /** Light/dark brand asset. */
    logo?: OrgLogoType;
  };
}

const { project, insertAfterSectionId, clientBranding } = Astro.props;
const slug = project.slug;

const all = getAllProjects();
const next = all[(project.index + 1) % all.length];

const displayProject = project;

const gh = displayProject.github;
const gallery = displayProject.gallery ?? [];
const kindLabel = displayProject.kind === "case-study" ? "Case study" : "Repository";
---

<article class="page pt-10 sm:pt-14 lg:pt-16">
  <header>
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-ink-faint">
      <a href="/projects" class="text-ink-muted transition-colors hover:text-accent">Projects</a>
      <span class="mx-2">/</span>
      <span class="text-ink">{displayProject.folio}</span>
      <span class="mx-2">/</span>
      <span>{kindLabel}</span>
    </nav>

    <div class="grid-12 mt-8 items-end">
      <div class="col-span-4 sm:col-span-8 lg:col-span-8">
        {
          clientBranding?.logo && (
            <div class="mb-6">
              <OrgLogo
                logo={clientBranding.logo}
                name={clientBranding.name}
                href={clientBranding.href}
                size={40}
              />
            </div>
          )
        }
        <h1 class="display text-[clamp(2.75rem,7.5vw,6rem)]">
          {displayProject.title}
        </h1>
      </div>
      <p class="col-span-4 mt-6 max-w-prose text-pretty text-lg leading-[1.4] text-ink sm:col-span-8 lg:col-span-4 lg:mt-0 lg:pb-2">
        {displayProject.subtitle}
      </p>
    </div>

    <div class="rule mt-8 sm:mt-12"></div>

    <dl class="grid-12 gap-y-6 pt-6">
      <div class="col-span-2 sm:col-span-2 lg:col-span-2">
        <dt class="meta">Status</dt>
        <dd class="mt-1 text-sm text-ink">{displayProject.status}</dd>
      </div>
      <div class="col-span-2 sm:col-span-2 lg:col-span-2">
        <dt class="meta">Years</dt>
        <dd class="mt-1 font-mono text-sm tabular-nums text-ink">{displayProject.years}</dd>
      </div>
      {
        gh && (
          <div class="col-span-4 sm:col-span-4 lg:col-span-2">
            <dt class="meta">Repository</dt>
            <dd class="mt-1 font-mono text-sm tabular-nums text-ink">
              {gh.commits} commits
              <span class="block text-ink-faint">last push {formatDate(gh.pushedAt)}</span>
            </dd>
          </div>
        )
      }
      <div class:list={["col-span-4 sm:col-span-8", gh ? "lg:col-span-3" : "lg:col-span-5"]}>
        <dt class="meta">Stack</dt>
        <dd class="mt-2 flex flex-wrap gap-1.5">
          {displayProject.stack.map((s) => <TechPill label={s} />)}
        </dd>
      </div>
      <div class="col-span-4 sm:col-span-8 lg:col-span-3">
        <dt class="meta">Links</dt>
        <dd class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-sm lg:flex-col">
          {displayProject.live && (
            <a class="link" href={displayProject.live} rel="noopener noreferrer">Live site</a>
          )}
          {displayProject.repoUrl && (
            <a class="link" href={displayProject.repoUrl} rel="noopener noreferrer">Source on GitHub</a>
          )}
          {!displayProject.live && !displayProject.repoUrl && (
            <span class="text-ink-faint">
              {displayProject.visibility === "private" ? "Private repository" : "No public link"}
            </span>
          )}
        </dd>
      </div>
    </dl>

    <p class="mt-12 max-w-prose text-pretty text-xl leading-[1.45] tracking-tight text-ink sm:text-2xl">
      {displayProject.caseStudyIntro}
    </p>
    {
      displayProject.privacyNote && (
        <p class="mt-4 max-w-prose text-sm text-ink-faint">{displayProject.privacyNote}</p>
      )
    }
  </header>

  {
    gallery.length > 0 && (
      <section class="mt-16 sm:mt-20" aria-label="Screenshots">
        <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
          {gallery.map((img, i) => (
            <figure class:list={[i === 0 && gallery.length % 2 === 1 && "sm:col-span-2"]} data-reveal>
              <img
                src={img.src}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                class="w-full border border-line bg-surface-raised"
              />
              <figcaption class="mt-3 text-sm leading-relaxed text-ink-muted">{img.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <div class="grid-12 mt-16 sm:mt-24">
    <nav aria-label="Sections" class="col-span-4 sm:col-span-8 lg:col-span-3">
      <ol class="flex flex-wrap gap-x-5 gap-y-2 border-t border-ink pt-4 lg:sticky lg:top-24 lg:block lg:space-y-2">
        {
          displayProject.sections.map((section, i) => (
            <li>
              <a
                href={`#${section.id}`}
                class="font-mono text-xs text-ink-muted transition-colors hover:text-accent"
              >
                <span class="tabular-nums text-ink-faint">{String(i + 1).padStart(2, "0")}</span>
                <span class="ml-2">{section.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="col-span-4 mt-10 sm:col-span-8 lg:col-span-8 lg:col-start-5 lg:mt-0">
      {
        displayProject.sections.map((section, i) => (
          <>
            <section
              class="case-study-section scroll-mt-24 border-t border-ink pt-5 [&+*]:mt-14"
              data-reveal
              id={section.id}
              aria-labelledby={`${section.id}-heading`}
            >
              <div class="flex items-baseline gap-4">
                <span class="folio">{String(i + 1).padStart(2, "0")}</span>
                <h2
                  id={`${section.id}-heading`}
                  class="text-2xl font-medium tracking-tight text-ink sm:text-3xl"
                >
                  {section.title}
                </h2>
              </div>
              <div class="prose-ed mt-6">
                {section.body?.map((p) => <p>{p}</p>)}
                {section.bullets && section.bullets.length > 0 && (
                  <ul class="mt-5 space-y-3">
                    {section.bullets.map((b) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.75em] h-px w-4 shrink-0 bg-ink" aria-hidden="true" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </section>
            {insertAfterSectionId === section.id && (
              <div class="mt-14 [&+*]:mt-14">
                <slot name="after-section" />
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>

  <footer class="rule grid-12 mt-24 pt-6 sm:mt-32">
    <a href="/projects" class="link col-span-2 self-start text-sm sm:col-span-4 lg:col-span-6">
      All projects
    </a>
    <a href={`/projects/${next.slug}`} class="group col-span-2 text-right sm:col-span-4 lg:col-span-6">
      <span class="meta block">Next</span>
      <span class="mt-1 block text-xl font-medium tracking-tight text-ink transition-colors group-hover:text-accent sm:text-2xl">
        {next.title}
      </span>
    </a>
  </footer>
</article>
