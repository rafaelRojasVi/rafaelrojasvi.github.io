---
import { getProjectBySlug } from "@/data/projects";
import SectionHeading from "@/components/SectionHeading.astro";
import TechPill from "@/components/TechPill.astro";
import OrigenLabHeaderLockup from "@/components/origenlab/logo/OrigenLabHeaderLockup.astro";

interface Props {
  slug: string;
  /** When set, render `<slot name="after-section" />` immediately after this section's id. */
  insertAfterSectionId?: string;
  /** Optional client logo linking to their live site (case study header). */
  clientBranding?: {
    href: string;
    name: string;
    logoSrc?: string;
    /** Live three-body canvas mark (OrigenLab). */
    animatedMark?: "origenlab";
  };
}

const { slug, insertAfterSectionId, clientBranding } = Astro.props;
const project = getProjectBySlug(slug);

if (!project) {
  throw new Error(`Unknown project slug: ${slug}`);
}
---

<div class="mx-auto max-w-6xl px-4 pb-24 pt-12 sm:px-6 sm:pt-16">
  <nav aria-label="Breadcrumb" class="font-mono text-xs text-ink-faint">
    <a href="/projects" class="text-ink-muted transition hover:text-accent"
      >Projects</a
    >
    <span class="mx-2 text-ink-faint">/</span>
    <span class="text-ink">{project.title}</span>
  </nav>

  <header class="mt-8">
    {
      clientBranding?.animatedMark === "origenlab" && (
        <a
          href={clientBranding.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mb-5 inline-flex items-center rounded-lg bg-[#042f2e] px-3.5 py-2.5 shadow-[0_0_0_1px_rgba(45,212,191,0.14)] transition hover:bg-[#0a3d3a] hover:shadow-[0_0_0_1px_rgba(45,212,191,0.28)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-400/80"
          title={`${clientBranding.name} — live site`}
        >
          <OrigenLabHeaderLockup size="prominent" />
          <span class="sr-only"> — live site</span>
        </a>
      )
    }
    {
      clientBranding?.logoSrc && !clientBranding.animatedMark && (
        <a
          href={clientBranding.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mb-5 inline-flex items-center rounded-lg border border-line/80 bg-surface-overlay/40 p-2 transition hover:border-accent/40 hover:bg-surface-overlay/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          title={`${clientBranding.name} — live site`}
        >
          <img
            src={clientBranding.logoSrc}
            alt={clientBranding.name}
            width="176"
            height="38"
            class="h-8 w-auto sm:h-9"
            loading="eager"
          />
        </a>
      )
    }
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-accent/90">
        Case study
      </p>
      <h1
        class="mt-3 text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
      >
        {project.title}
      </h1>
      <p class="mt-3 text-lg text-ink-muted">{project.subtitle}</p>
      <p class="mt-5 max-w-2xl text-pretty text-base leading-[1.7] text-ink-muted">
        {project.caseStudyIntro}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span
          class="rounded-full border border-line bg-surface-overlay/80 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-accent"
        >
          {project.status}
        </span>
        {project.privacyNote && (
          <span class="max-w-xl text-xs leading-relaxed text-ink-faint">
            {project.privacyNote}
          </span>
        )}
      </div>
      <div class="mt-6 flex flex-wrap gap-1.5">
        {project.stack.map((s) => (
          <TechPill label={s} />
        ))}
      </div>
    </div>
  </header>

  <div class="mt-16 space-y-10 sm:space-y-12">
    {
      project.sections.map((section) => (
        <>
          <section
            class:list={[
              "scroll-mt-28 rounded-2xl border border-line/80 bg-surface-overlay/25 px-6 py-7 sm:p-8",
              slug === "origenlab" && "case-study-section",
            ]}
            id={section.id}
            aria-labelledby={`${section.id}-heading`}
          >
            <SectionHeading id={`${section.id}-heading`} title={section.title} />
            <div class="mt-5 max-w-3xl space-y-4 text-sm leading-[1.7] text-ink-muted sm:text-base">
              {section.body?.map((p) => (
                <p>{p}</p>
              ))}
              {section.bullets && section.bullets.length > 0 && (
                <ul class="mt-2 space-y-2">
                  {section.bullets.map((b) => (
                    <li class="flex gap-2">
                      <span
                        class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70"
                        aria-hidden="true"
                      />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>
          {insertAfterSectionId === section.id && (
            <div class="not-prose">
              <slot name="after-section" />
            </div>
          )}
        </>
      ))
    }
  </div>

  <footer
    class="mt-20 flex flex-col gap-4 border-t border-line/80 pt-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="font-mono text-sm text-ink-muted">
      <span class="text-ink">{project.title}</span>
      <span class="text-ink-faint"> · case study</span>
    </p>
    <a
      href="/projects"
      class="inline-flex items-center gap-2 font-mono text-sm font-medium text-accent transition hover:text-ink"
    >
      ← Project index
    </a>
  </footer>
</div>
