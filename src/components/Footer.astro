---
import { profile } from "@/data/profile";
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-ink">
  <div class="page grid-12 py-10">
    <div class="col-span-4 sm:col-span-4 lg:col-span-5">
      <p class="text-sm text-ink">{profile.name}</p>
      <p class="mt-1 text-sm text-ink-muted">
        Backend software engineer. {profile.location}.
      </p>
    </div>
    <ul
      class="col-span-4 mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm sm:col-span-4 sm:mt-0 lg:col-span-4"
    >
      <li>
        <a class="link no-underline hover:underline" href={`mailto:${profile.contact.email}`}>Email</a>
      </li>
      <li>
        <a class="link no-underline hover:underline" href={profile.contact.github} rel="noopener noreferrer">GitHub</a>
      </li>
      <li>
        <a class="link no-underline hover:underline" href={profile.contact.linkedIn} rel="noopener noreferrer">LinkedIn</a>
      </li>
    </ul>
    <p
      class="col-span-4 mt-6 font-mono text-[11px] text-ink-faint sm:col-span-8 sm:mt-0 lg:col-span-3 lg:text-right"
    >
      Static site, no trackers. {year}
    </p>
  </div>
</footer>
