---
import { profile } from "@/data/profile";

const links = [
  { href: "/projects", label: "Projects" },
  { href: "/experience", label: "Experience" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink bg-surface/95 backdrop-blur-sm">
  <div class="page flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="flex items-baseline gap-3 font-medium tracking-tight text-ink no-underline transition-colors hover:text-accent"
    >
      <span>{profile.name}</span>
      <span class="hidden font-mono text-[11px] uppercase tracking-meta text-ink-faint sm:inline">
        Backend engineer
      </span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-5 sm:gap-8">
      {
        links.map(({ href, label }) => {
          const active =
            pathname === href || pathname.startsWith(`${href}/`);
          return (
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "text-sm transition-colors hover:text-accent",
                active
                  ? "text-ink underline decoration-accent decoration-2 underline-offset-[6px]"
                  : "text-ink-muted",
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
