---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/experience", label: "Experience" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-line/80 bg-surface/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      class="group flex items-center gap-2 rounded-md font-mono text-sm text-ink transition hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <span
        class="inline-flex h-2 w-2 rounded-full bg-accent shadow-glow shadow-accent/40 transition group-hover:shadow-accent/60"
        aria-hidden="true"
      />
      <span class="font-semibold tracking-tight">rafael.rojas</span>
      <span class="hidden text-ink-faint sm:inline">/ backend</span>
    </a>

    <nav aria-label="Primary" class="flex flex-wrap items-center gap-1 sm:gap-2">
      {
        links.map(({ href, label }) => {
          const active =
            href === "/"
              ? pathname === "/"
              : pathname === href || pathname.startsWith(`${href}/`);
          return (
            <a
              href={href}
              class:list={[
                "rounded-md px-3 py-2 font-mono text-xs uppercase tracking-wider transition",
                active
                  ? "bg-surface-overlay text-accent"
                  : "text-ink-muted hover:bg-surface-overlay/60 hover:text-ink",
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
