---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/experience", label: "Experience" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-line/60 bg-surface/90 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      title="Home"
      aria-label="Home — shell prompt: rafaelrojasvi.github.io on branch main (uncommitted changes)"
      class="group min-w-0 max-w-[calc(100%-9rem)] overflow-x-auto rounded-md py-1 font-mono text-[10px] leading-tight no-underline [-ms-overflow-style:none] [scrollbar-width:none] transition-colors hover:bg-surface-overlay/40 sm:max-w-none sm:text-[11px] sm:leading-none md:text-sm [&::-webkit-scrollbar]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <span class="inline-flex items-center gap-0 whitespace-nowrap">
        <span class="text-accent transition group-hover:text-ink">➜</span>
        <span class="text-ink">&nbsp;&nbsp;</span>
        <span class="text-ink transition group-hover:text-accent">rafaelrojasvi.github.io</span>
        <span class="text-ink-faint">&nbsp;git:(</span>
        <span class="text-accent-dim">main</span>
        <span class="text-ink-faint">)</span>
        <span class="text-ink-muted">&nbsp;✗</span>
        <span
          class="navbar-prompt-cursor ml-1 inline-block h-[1.05em] w-[2px] shrink-0 rounded-[1px] bg-accent"
          aria-hidden="true"
        />
      </span>
    </a>

    <nav aria-label="Primary" class="flex flex-wrap items-center gap-1 sm:gap-2">
      {
        links.map(({ href, label }) => {
          const active =
            href === "/"
              ? pathname === "/"
              : pathname === href || pathname.startsWith(`${href}/`);
          return (
            <a
              href={href}
              class:list={[
                "rounded-md px-3 py-2 font-mono text-xs uppercase tracking-wider transition",
                active
                  ? "bg-surface-overlay text-accent shadow-[inset_0_0_0_1px_rgba(129,140,248,0.22)]"
                  : "text-ink-muted hover:bg-surface-overlay/50 hover:text-accent",
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<style>
  @keyframes navbar-prompt-cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .navbar-prompt-cursor {
    animation: navbar-prompt-cursor-blink 1.05s step-end infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-prompt-cursor {
      animation: none;
      opacity: 1;
    }
  }
</style>
