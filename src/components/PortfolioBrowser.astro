---
import "@/styles/inet-shell.css";
import { profile } from "@/data/profile";

interface Props {
  /** Display URL in the address chrome (not editable). */
  address: string;
  /** Window title bar text. */
  windowTitle?: string;
  /** Status bar object count label. */
  objectsLabel?: string;
  /** Decorative system identity (not analytics). */
  nodeLabel?: string;
  buildLabel?: string;
  lastUpdated?: string;
  /**
   * Desktop: compact sticky SYSTEM rail (align-self start + sticky).
   * Used on long pages (/ and /projects). Offset accounts for sticky chrome.
   */
  stickySide?: boolean;
}

const {
  address,
  windowTitle = "rafaelrojasvi.github.io - Internet Explorer",
  objectsLabel = "Ready",
  nodeLabel = "node 0027",
  buildLabel = "2026.08",
  lastUpdated = "09 Aug 2026",
  stickySide = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/", label: "HOME", match: "/" },
  { href: "/projects", label: "PROJECTS", match: "/projects" },
  { href: "/experience", label: "EXPERIENCE", match: "/experience" },
  { href: "/about", label: "ABOUT", match: "/about" },
  {
    href: `mailto:${profile.contact.email}`,
    label: "CONTACT",
    match: null as string | null,
  },
];

function isHere(match: string | null): boolean {
  if (match === null) return false;
  if (match === "/") return pathname === "/";
  return pathname === match || pathname.startsWith(`${match}/`);
}

const locationCode = `${profile.location
  .split(",")[0]
  .trim()
  .toUpperCase()
  .replace(/\s+/g, "_")}_CL`;

const toolbox = [
  { id: "python", label: "Python", src: "/design-lab/sidebar/px-python.svg" },
  { id: "elixir", label: "Elixir", src: "/design-lab/sidebar/px-elixir.svg" },
  { id: "api", label: "APIs", src: "/design-lab/sidebar/px-api.svg" },
  { id: "pg", label: "PgSQL", src: "/design-lab/sidebar/px-postgres.svg" },
  { id: "sqlite", label: "SQLite", src: "/design-lab/sidebar/px-sqlite.svg" },
  { id: "docker", label: "Docker", src: "/design-lab/sidebar/px-docker.svg" },
  { id: "git", label: "Git", src: "/design-lab/sidebar/px-git.svg" },
] as const;

const nowUsing = [
  { label: "PYTHON", src: "/design-lab/sidebar/px-python.svg" },
  { label: "ELIXIR", src: "/design-lab/sidebar/px-elixir.svg" },
  { label: "FASTAPI", src: "/design-lab/sidebar/px-api.svg" },
  { label: "POSTGRES", src: "/design-lab/sidebar/px-postgres.svg" },
] as const;

const quickLinks = [
  {
    href: `mailto:${profile.contact.email}`,
    label: "EMAIL ME",
    kind: "mail" as const,
  },
  {
    href: profile.contact.github,
    label: "GITHUB",
    kind: "git" as const,
  },
  {
    href: profile.contact.linkedIn,
    label: "LINKEDIN",
    kind: "in" as const,
  },
  {
    href: "/experience",
    label: "RESUME.TXT",
    kind: "doc" as const,
  },
];
---

<div class="inet-site">
  <div class="inet-stage">
    <div class="inet-browser">
      <div class="inet-chrome">
        <div class="inet-titlebar">
          <span class="inet-titlebar__icon" aria-hidden="true"></span>
          <span class="inet-titlebar__text">{windowTitle}</span>
          <div class="inet-titlebar__ctl" aria-hidden="true">
            <span>_</span><span>□</span><span>×</span>
          </div>
        </div>

        <div class="inet-menubar" aria-hidden="true">
          <span><u>F</u>ile</span>
          <span><u>E</u>dit</span>
          <span><u>V</u>iew</span>
          <span>F<u>a</u>vorites</span>
          <span><u>H</u>elp</span>
        </div>

        <!-- Decorative IE-era command toolbar (noninteractive chrome) -->
        <div class="inet-cmdbar" aria-hidden="true">
          <span class="inet-cmd">
            <span class="inet-cmd__ico inet-cmd__ico--back"></span>
            <span class="inet-cmd__label">Back</span>
          </span>
          <span class="inet-cmd inet-cmd--icon">
            <span class="inet-cmd__ico inet-cmd__ico--fwd"></span>
          </span>
          <span class="inet-cmd">
            <span class="inet-cmd__ico inet-cmd__ico--stop"></span>
            <span class="inet-cmd__label">Stop</span>
          </span>
          <span class="inet-cmd">
            <span class="inet-cmd__ico inet-cmd__ico--refresh"></span>
            <span class="inet-cmd__label">Refresh</span>
          </span>
          <span class="inet-cmd">
            <span class="inet-cmd__ico inet-cmd__ico--home"></span>
            <span class="inet-cmd__label">Home</span>
          </span>
          <span class="inet-cmdbar__grow"></span>
          <span class="inet-throbber" title=""></span>
        </div>

        <div class="inet-toolbar">
          <span class="inet-toolbar__label">Address</span>
          <div class="inet-address" aria-label={`Address: ${address}`}>
            <span class="inet-address__ico" aria-hidden="true"></span>
            <span class="inet-address__url">{address}</span>
          </div>
          <a class="inet-go" href={pathname === "/" ? "/" : pathname}>Go</a>
        </div>
      </div>

      <div class="inet-page">
        <div
          class:list={["inet-layout", stickySide && "inet-layout--sticky-side"]}
        >
          <aside class="inet-side">
            <p class="inet-side__head">Navigation</p>
            <nav class="inet-nav" aria-label="Site">
              {
                nav.map((item) => (
                  <a
                    class:list={[
                      "inet-nav__a",
                      isHere(item.match) && "inet-nav__a--here",
                    ]}
                    href={item.href}
                    aria-current={isHere(item.match) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>

            <hr class="inet-hr" />

            <p class="inet-side__head">System</p>
            <dl class="inet-sys">
              <div>
                <dt>status</dt>
                <dd>
                  <span class="inet-led inet-led--live" aria-hidden="true"
                  ></span>{" "}
                  ONLINE
                </dd>
              </div>
              <div>
                <dt>location</dt>
                <dd>{locationCode}</dd>
              </div>
              <div>
                <dt>build</dt>
                <dd>{buildLabel}</dd>
              </div>
              <div>
                <dt>id</dt>
                <dd>{nodeLabel}</dd>
              </div>
            </dl>

            <div class="inet-deco" aria-hidden="true">
              <div class="inet-px-wrap">
                <img
                  class="inet-px"
                  src="/design-lab/px-crt.svg"
                  width="32"
                  height="32"
                  alt=""
                />
                <span class="inet-px-cap">sys_crt.gif</span>
              </div>

              <div class="inet-meter">
                <span class="inet-meter__cap">sig</span>
                <span class="inet-meter__track"
                  ><span class="inet-meter__fill"></span></span
                >
              </div>

              <div class="inet-badge">
                <span class="inet-badge__dot"></span>
                <span class="inet-badge__text">RAFA<br />ONLINE</span>
              </div>
            </div>

            <hr class="inet-hr" />

            <p class="inet-side__head">Toolbox</p>
            <ul class="inet-toolbox">
              {
                toolbox.map((tool) => (
                  <li class="inet-toolbox__item">
                    <img
                      class="inet-toolbox__ico"
                      src={tool.src}
                      width="16"
                      height="16"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="inet-toolbox__lab">{tool.label}</span>
                  </li>
                ))
              }
            </ul>

            <!-- Decorative ticker: visual only; static list for AT / reduced-motion -->
            <div class="inet-now" data-inet-now>
              <p class="inet-side__head">Now using</p>
              <p class="inet-now__sr">
                {nowUsing.map((n) => n.label).join(" · ")}
              </p>
              <div class="inet-now__panel" aria-hidden="true">
                <img
                  class="inet-now__ico"
                  src={nowUsing[0].src}
                  width="16"
                  height="16"
                  alt=""
                  data-inet-now-ico
                />
                <span class="inet-now__lab" data-inet-now-lab
                  >{nowUsing[0].label}</span
                >
              </div>
              <script
                type="application/json"
                data-inet-now-data
                set:html={JSON.stringify(nowUsing)}
              />
            </div>

            <hr class="inet-hr" />

            <p class="inet-side__head">Links</p>
            <div class="inet-88s">
              {
                quickLinks.map((link) => (
                  <a
                    class:list={[
                      "inet-88",
                      `inet-88--${link.kind}`,
                      link.kind === "mail" && "inet-88--anim",
                    ]}
                    href={link.href}
                    {...(link.kind === "git" || link.kind === "in"
                      ? {
                          target: "_blank",
                          rel: "noopener noreferrer",
                        }
                      : {})}
                  >
                    {link.kind === "mail" ? (
                      <span class="inet-88__mail" aria-hidden="true">
                        <img
                          src="/design-lab/sidebar/px-mail.svg"
                          width="16"
                          height="16"
                          alt=""
                        />
                      </span>
                    ) : (
                      <span class="inet-88__mark" aria-hidden="true" />
                    )}
                    <span class="inet-88__txt">{link.label}</span>
                  </a>
                ))
              }
            </div>

            <div class="inet-side-badges" aria-hidden="true">
              <img
                class="inet-side-badges__img"
                src="/design-lab/sidebar/badge-astro.svg"
                width="88"
                height="31"
                alt=""
              />
              <img
                class="inet-side-badges__img"
                src="/design-lab/sidebar/badge-bestview.svg"
                width="88"
                height="31"
                alt=""
              />
            </div>

            <p class="inet-tiny">
              last updated<br />
              {lastUpdated}
            </p>
          </aside>

          <div class="inet-main">
            <slot />
          </div>
        </div>
      </div>

      <div class="inet-statusbar" role="status">
        <span class="inet-statusbar__pane">Done</span>
        <span class="inet-statusbar__sep" aria-hidden="true"></span>
        <span class="inet-statusbar__pane">{objectsLabel}</span>
        <span class="inet-statusbar__sep" aria-hidden="true"></span>
        <span class="inet-statusbar__pane">Internet zone</span>
        <span class="inet-statusbar__grow"></span>
        <span class="inet-statusbar__pane"
          ><span class="inet-led inet-led--sm" aria-hidden="true"></span> ONLINE</span
        >
      </div>
    </div>
  </div>
</div>

<script>
  function bootNowUsing(root: HTMLElement) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const raw = root.querySelector("[data-inet-now-data]")?.textContent;
    if (!raw) return;
    let items: { label: string; src: string }[] = [];
    try {
      items = JSON.parse(raw);
    } catch {
      return;
    }
    if (items.length < 2) return;

    const ico = root.querySelector<HTMLImageElement>("[data-inet-now-ico]");
    const lab = root.querySelector<HTMLElement>("[data-inet-now-lab]");
    if (!ico || !lab) return;

    root.classList.add("inet-now--live");
    let i = 0;
    window.setInterval(() => {
      i = (i + 1) % items.length;
      const next = items[i];
      ico.src = next.src;
      lab.textContent = next.label;
    }, 3000);
  }

  document.querySelectorAll<HTMLElement>("[data-inet-now]").forEach(bootNowUsing);
</script>
