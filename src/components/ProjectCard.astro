---
import type { Project } from "@/data/projects";
import TechPill from "@/components/TechPill.astro";

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const href = `/projects/${project.slug}`;
---

<article
  class:list={[
    "group relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface-overlay/50 p-5 shadow-card transition",
    "hover:-translate-y-0.5 hover:border-accent/25 hover:shadow-[0_0_0_1px_rgba(52,211,199,0.12),0_28px_56px_-28px_rgba(0,0,0,0.75)]",
    featured && "ring-1 ring-accent/15",
  ]}
>
  <div
    class="pointer-events-none absolute inset-0 opacity-0 transition group-hover:opacity-100"
    aria-hidden="true"
  >
    <div
      class="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-accent/10 blur-3xl"
    />
  </div>

  <header class="relative border-b border-line/80 pb-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-ink-faint">
          Case file
        </p>
        <h3 class="mt-1 text-lg font-semibold tracking-tight text-ink">
          <a
            href={href}
            class="rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {project.title}
            <span class="absolute inset-0 sm:hidden" aria-hidden="true" />
          </a>
        </h3>
        <p class="mt-1 text-sm text-ink-muted">{project.subtitle}</p>
      </div>
      <span
        class="shrink-0 rounded border border-line bg-surface/80 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-accent/90"
      >
        {project.status}
      </span>
    </div>
  </header>

  <p class="relative mt-4 flex-1 text-sm leading-relaxed text-ink-muted">
    {project.shortDescription}
  </p>

  <div class="relative mt-4 space-y-3">
    <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-faint">
      Engineering focus
    </p>
    <ul class="space-y-1.5 text-sm text-ink-muted">
      {project.engineeringFocus.map((line) => (
        <li class="flex gap-2">
          <span class="mt-2 h-px w-3 shrink-0 bg-accent/50" aria-hidden="true" />
          <span>{line}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="relative mt-5 flex flex-wrap gap-1.5">
    {project.stack.slice(0, 6).map((s) => (
      <TechPill label={s} />
    ))}
    {project.stack.length > 6 && (
      <span class="self-center font-mono text-[10px] text-ink-faint">
        +{project.stack.length - 6}
      </span>
    )}
  </div>

  <footer class="relative mt-5 flex items-center justify-between gap-3 border-t border-line/60 pt-4">
    <span class="font-mono text-xs text-ink-faint">SYS.{project.slug}</span>
    <a
      href={href}
      class="relative z-10 font-mono text-xs font-medium uppercase tracking-wider text-accent transition hover:text-ink"
    >
      Open dossier →
    </a>
  </footer>
</article>
