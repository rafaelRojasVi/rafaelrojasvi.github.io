---
import type { Project } from "@/data/projects";
import TechPill from "@/components/TechPill.astro";

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const href = `/projects/${project.slug}`;
---

<article
  class:list={[
    "group relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface-overlay/50 p-6 shadow-card transition-colors",
    "hover:border-accent/30",
    featured && "ring-1 ring-accent/10",
  ]}
>
  <header class="relative border-b border-line/80 pb-5">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-ink-faint">
          Project
        </p>
        <h3 class="mt-1.5 text-lg font-semibold leading-snug tracking-tight text-ink">
          <a
            href={href}
            class="rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {project.title}
            <span class="absolute inset-0 sm:hidden" aria-hidden="true" />
          </a>
        </h3>
        <p class="mt-2 text-sm leading-snug text-ink-muted">{project.subtitle}</p>
      </div>
      <span
        class="shrink-0 rounded border border-line bg-surface/80 px-2 py-1 text-right font-mono text-[10px] uppercase leading-tight tracking-wider text-accent/90"
      >
        {project.status}
      </span>
    </div>
  </header>

  <p class="relative mt-5 flex-1 text-sm leading-relaxed text-ink-muted">
    {project.shortDescription}
  </p>

  <div class="relative mt-5 space-y-2">
    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-faint">
      Highlights
    </p>
    <ul class="space-y-2 text-sm leading-snug text-ink-muted">
      {project.engineeringFocus.map((line) => (
        <li class="flex gap-2.5">
          <span class="mt-2 h-px w-3 shrink-0 bg-accent/50" aria-hidden="true" />
          <span>{line}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="relative mt-6">
    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-faint">
      Stack
    </p>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {project.stack.slice(0, 7).map((s) => (
        <TechPill label={s} />
      ))}
      {project.stack.length > 7 && (
        <span class="self-center font-mono text-[10px] text-ink-faint">
          +{project.stack.length - 7}
        </span>
      )}
    </div>
  </div>

  <footer class="relative mt-6 flex items-center justify-between gap-3 border-t border-line/60 pt-5">
    <span class="truncate font-mono text-[11px] text-ink-faint">{project.slug}</span>
    <a
      href={href}
      class="relative z-10 shrink-0 font-mono text-xs font-medium uppercase tracking-wider text-accent transition hover:text-ink"
    >
      Case study →
    </a>
  </footer>
</article>
