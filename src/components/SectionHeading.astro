---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { id, eyebrow, title, description, align = "left" } = Astro.props;
---

<div
  class:list={[
    "max-w-3xl",
    align === "center" && "mx-auto text-center",
  ]}
>
  {
    eyebrow && (
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent/90">
        {eyebrow}
      </p>
    )
  }
  <h2
    id={id}
    class:list={[
      "mt-3 text-2xl font-semibold tracking-tight text-ink hyphens-none sm:text-3xl",
      align === "center" && "mx-auto",
    ]}
    style="text-wrap: pretty;"
  >
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-ink-muted sm:leading-[1.65]">
        {description}
      </p>
    )
  }
</div>
