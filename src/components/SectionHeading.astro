---
interface Props {
  id?: string;
  /** Kept for compatibility; rendered as a small mono label. Use sparingly. */
  eyebrow?: string;
  title: string;
  description?: string;
  /** Visual size: `section` for page sections, `sub` for in-article headings. */
  size?: "section" | "sub";
}

const { id, eyebrow, title, description, size = "section" } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="meta mb-3">{eyebrow}</p>}
  <h2
    id={id}
    class:list={[
      "font-medium tracking-tight text-ink",
      size === "section"
        ? "text-3xl leading-[1.05] sm:text-4xl"
        : "text-xl leading-tight sm:text-2xl",
    ]}
  >
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 max-w-prose text-pretty text-base leading-[1.6] text-ink-muted">
        {description}
      </p>
    )
  }
</div>
