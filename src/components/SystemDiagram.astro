---
interface Props {
  class?: string;
  variant?: "hero" | "inline";
}

const { class: className = "", variant = "inline" } = Astro.props;
---

<div
  class:list={[
    "system-diagram relative overflow-hidden rounded-2xl border border-line/80 bg-surface-overlay/30",
    variant === "hero" && "min-h-[220px] sm:min-h-[280px]",
    variant === "inline" && "p-4",
    className,
  ]}
  role="img"
  aria-label="Three-stage pipeline diagram: ingest, validate, emit. Hover each stage for a short description."
>
  <div
    class="sys-diagram-shimmer pointer-events-none absolute inset-0 opacity-80"
    aria-hidden="true"
  />
  <svg
    class="sys-diagram-svg relative z-[1] h-full w-full"
    viewBox="0 0 400 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
  >
    <title>Pipeline: ingest → validate → emit</title>
    <defs>
      <linearGradient id="sys-wire" x1="0" y1="0" x2="400" y2="0">
        <stop offset="0%" stop-color="rgba(129,140,248,0)" />
        <stop offset="50%" stop-color="rgba(129,140,248,0.4)" />
        <stop offset="100%" stop-color="rgba(129,140,248,0)" />
      </linearGradient>
    </defs>

    <path
      class="sys-path-primary"
      d="M20 100 H120 Q140 100 150 80 T180 60 H240 Q260 60 270 80 T300 100 H380"
      stroke="url(#sys-wire)"
      stroke-width="1.2"
      stroke-linecap="round"
    />
    <path
      class="sys-path-secondary"
      d="M40 140 H130 Q150 140 160 120 T200 90 H320 Q340 90 350 110 T380 130"
      stroke="rgba(148,163,184,0.22)"
      stroke-width="1"
      stroke-linecap="round"
    />

    <g
      class="sys-stage outline-none"
      tabindex="0"
      data-stage="ingest"
    >
      <title>Ingest — raw signals and messy inputs enter the pipeline.</title>
      <rect
        x="32"
        y="88"
        width="56"
        height="24"
        rx="6"
        class="sys-stage-rect"
        stroke="rgba(129,140,248,0.45)"
        fill="rgba(12,16,24,0.6)"
      />
      <text
        x="60"
        y="104"
        text-anchor="middle"
        fill="rgba(148,163,184,0.9)"
        font-family="JetBrains Mono, ui-monospace, monospace"
        font-size="9">INGEST</text>
    </g>

    <g
      class="sys-stage outline-none"
      tabindex="0"
      data-stage="validate"
    >
      <title>Validate — structure, checks, and rules before anything is emitted.</title>
      <rect
        x="168"
        y="48"
        width="64"
        height="28"
        rx="6"
        class="sys-stage-rect"
        stroke="rgba(129,140,248,0.35)"
        fill="rgba(17,24,39,0.55)"
      />
      <text
        x="200"
        y="65"
        text-anchor="middle"
        fill="rgba(148,163,184,0.9)"
        font-family="JetBrains Mono, ui-monospace, monospace"
        font-size="9">VALIDATE</text>
    </g>

    <g
      class="sys-stage outline-none"
      tabindex="0"
      data-stage="emit"
    >
      <title>Emit — outputs, exports, or downstream handoff.</title>
      <rect
        x="268"
        y="88"
        width="72"
        height="26"
        rx="6"
        class="sys-stage-rect"
        stroke="rgba(129,140,248,0.4)"
        fill="rgba(12,16,24,0.65)"
      />
      <text
        x="304"
        y="104"
        text-anchor="middle"
        fill="rgba(148,163,184,0.9)"
        font-family="JetBrains Mono, ui-monospace, monospace"
        font-size="9">EMIT</text>
    </g>

    <g class="sys-dots" opacity="0.95" aria-hidden="true">
      <circle class="sys-dot sys-dot--a" cx="128" cy="100" r="3" fill="rgba(129,140,248,0.85)" />
      <circle class="sys-dot sys-dot--b" cx="248" cy="72" r="2.5" fill="rgba(129,140,248,0.55)" />
      <circle class="sys-dot sys-dot--c" cx="312" cy="118" r="2.5" fill="rgba(148,163,184,0.45)" />
    </g>

    <g stroke="rgba(129,140,248,0.15)" stroke-width="1" aria-hidden="true">
      <path class="sys-path-tertiary" d="M60 160 h80" stroke-dasharray="3 6" />
      <path class="sys-path-tertiary" d="M200 155 h100" stroke-dasharray="3 6" />
    </g>
    <text
      class="sys-caption"
      x="48"
      y="176"
      fill="rgba(100,116,139,0.8)"
      font-family="JetBrains Mono, ui-monospace, monospace"
      font-size="8">// pipeline: messy → structured → reliable</text>
  </svg>
</div>

<style is:global>
  @keyframes sys-pipeline-dash {
    to {
      stroke-dashoffset: 240;
    }
  }

  @keyframes sys-dot-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes sys-caption-soft {
    0%,
    100% {
      opacity: 0.72;
    }
    50% {
      opacity: 0.95;
    }
  }

  .system-diagram .sys-diagram-shimmer {
    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(129, 140, 248, 0.06) 45%,
      rgba(129, 140, 248, 0.1) 50%,
      rgba(129, 140, 248, 0.06) 55%,
      transparent 100%
    );
    opacity: 0.72;
  }

  .system-diagram .sys-path-primary {
    stroke-dasharray: 6 14;
    animation: sys-pipeline-dash 20s linear infinite;
  }

  .system-diagram .sys-path-secondary {
    stroke-dasharray: 5 12;
    animation: sys-pipeline-dash 26s linear infinite;
  }

  .system-diagram .sys-path-tertiary {
    animation: sys-pipeline-dash 32s linear infinite;
  }

  .system-diagram .sys-dot {
    animation: sys-dot-pulse 2.8s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  .system-diagram .sys-dot--b {
    animation-delay: 0.65s;
  }

  .system-diagram .sys-dot--c {
    animation-delay: 1.3s;
  }

  .system-diagram .sys-caption {
    animation: sys-caption-soft 5s ease-in-out infinite;
  }

  .system-diagram .sys-stage {
    cursor: help;
  }

  .system-diagram .sys-stage .sys-stage-rect {
    transition:
      stroke 0.18s ease,
      filter 0.18s ease,
      fill 0.18s ease;
  }

  .system-diagram .sys-stage:hover .sys-stage-rect,
  .system-diagram .sys-stage:focus-visible .sys-stage-rect {
    stroke: rgba(129, 140, 248, 0.95);
    filter: drop-shadow(0 0 12px rgba(129, 140, 248, 0.28));
    fill: rgba(17, 24, 39, 0.75);
  }

  .system-diagram .sys-stage:focus-visible {
    outline: none;
  }

  .system-diagram .sys-stage:focus-visible .sys-stage-rect {
    stroke-width: 1.5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .system-diagram .sys-diagram-shimmer,
    .system-diagram .sys-path-primary,
    .system-diagram .sys-path-secondary,
    .system-diagram .sys-path-tertiary,
    .system-diagram .sys-dot,
    .system-diagram .sys-caption {
      animation: none !important;
    }

    .system-diagram .sys-path-primary,
    .system-diagram .sys-path-secondary,
    .system-diagram .sys-path-tertiary {
      stroke-dasharray: none;
    }

    .system-diagram .sys-dot {
      opacity: 0.85;
    }

    .system-diagram .sys-diagram-shimmer {
      opacity: 0.5;
      transform: none;
    }
  }
</style>
