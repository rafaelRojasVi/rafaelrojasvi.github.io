---
interface Props {
  class?: string;
  variant?: "hero" | "inline";
}

const { class: className = "", variant = "inline" } = Astro.props;
---

<div
  class:list={[
    "relative overflow-hidden rounded-2xl border border-line/80 bg-surface-overlay/30",
    variant === "hero" && "min-h-[220px] sm:min-h-[280px]",
    variant === "inline" && "p-4",
    className,
  ]}
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-[linear-gradient(120deg,transparent_40%,rgba(52,211,199,0.04)_50%,transparent_60%)]"
  />
  <svg
    class="h-full w-full opacity-90"
    viewBox="0 0 400 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
  >
    <defs>
      <linearGradient id="wire" x1="0" y1="0" x2="400" y2="0">
        <stop offset="0%" stop-color="rgba(52,211,199,0)" />
        <stop offset="50%" stop-color="rgba(52,211,199,0.35)" />
        <stop offset="100%" stop-color="rgba(52,211,199,0)" />
      </linearGradient>
    </defs>

    <path
      d="M20 100 H120 Q140 100 150 80 T180 60 H240 Q260 60 270 80 T300 100 H380"
      stroke="url(#wire)"
      stroke-width="1.2"
      stroke-linecap="round"
    />
    <path
      d="M40 140 H130 Q150 140 160 120 T200 90 H320 Q340 90 350 110 T380 130"
      stroke="rgba(148,163,184,0.2)"
      stroke-width="1"
      stroke-linecap="round"
    />

    <g>
      <rect
        x="32"
        y="88"
        width="56"
        height="24"
        rx="6"
        stroke="rgba(52,211,199,0.45)"
        fill="rgba(12,16,24,0.6)"
      />
      <text
        x="60"
        y="104"
        text-anchor="middle"
        fill="rgba(148,163,184,0.85)"
        font-family="JetBrains Mono, monospace"
        font-size="9">INGEST</text>
    </g>

    <g>
      <rect
        x="168"
        y="48"
        width="64"
        height="28"
        rx="6"
        stroke="rgba(52,211,199,0.35)"
        fill="rgba(17,24,39,0.55)"
      />
      <text
        x="200"
        y="65"
        text-anchor="middle"
        fill="rgba(148,163,184,0.85)"
        font-family="JetBrains Mono, monospace"
        font-size="9">VALIDATE</text>
    </g>

    <g>
      <rect
        x="268"
        y="88"
        width="72"
        height="26"
        rx="6"
        stroke="rgba(52,211,199,0.4)"
        fill="rgba(12,16,24,0.65)"
      />
      <text
        x="304"
        y="104"
        text-anchor="middle"
        fill="rgba(148,163,184,0.85)"
        font-family="JetBrains Mono, monospace"
        font-size="9">EMIT</text>
    </g>

    <g opacity="0.85">
      <circle cx="128" cy="100" r="3" fill="rgba(52,211,199,0.8)" />
      <circle cx="248" cy="72" r="2.5" fill="rgba(52,211,199,0.45)" />
      <circle cx="312" cy="118" r="2.5" fill="rgba(148,163,184,0.35)" />
    </g>

    <g stroke="rgba(52,211,199,0.15)" stroke-width="1">
      <path d="M60 160 h80" stroke-dasharray="3 6" />
      <path d="M200 155 h100" stroke-dasharray="3 6" />
    </g>
    <text
      x="48"
      y="176"
      fill="rgba(100,116,139,0.75)"
      font-family="JetBrains Mono, monospace"
      font-size="8">// pipeline: messy → structured → reliable</text>
  </svg>
</div>
