---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span
  class="inline-flex items-center rounded-full border border-line bg-surface-overlay/80 px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wide text-ink-muted shadow-sm transition hover:border-accent/35 hover:text-accent"
>
  {label}
</span>
