---
import OrgLogo from "@/components/OrgLogo.astro";
import type { OrgLogo as OrgLogoType } from "@/data/profile";

interface Props {
  title: string;
  org?: string;
  orgUrl?: string;
  logo?: OrgLogoType;
  dates: string;
  location: string;
  bullets?: string[];
  featured?: boolean;
  compact?: boolean;
}

const {
  title,
  org,
  orgUrl,
  logo,
  dates,
  location,
  bullets = [],
  compact = false,
} = Astro.props;

const orgLine = org?.trim();
---

<li class="grid-12 border-t border-line py-7 sm:py-9" data-reveal>
  <div class="col-span-4 sm:col-span-8 lg:col-span-3">
    <p class="font-mono text-xs tabular-nums text-ink">{dates}</p>
    <p class="mt-1 font-mono text-xs text-ink-faint">{location}</p>
    {
      logo && (
        <div class="mt-5 hidden lg:block">
          <OrgLogo logo={logo} name={orgLine ?? title} href={orgUrl} size={30} />
        </div>
      )
    }
  </div>
  <div class="col-span-4 mt-3 sm:col-span-8 lg:col-span-9 lg:mt-0">
    <h3
      class:list={[
        "font-medium tracking-tight text-ink",
        compact ? "text-lg" : "text-xl sm:text-2xl",
      ]}
    >
      {title}
    </h3>
    {
      orgLine && (
        <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-2 text-base text-ink-muted">
          {logo && (
            <span class="lg:hidden">
              <OrgLogo logo={logo} name={orgLine} href={orgUrl} size={22} />
            </span>
          )}
          <span>{orgLine}</span>
        </p>
      )
    }
    {
      bullets.length > 0 && (
        <ul class="mt-5 max-w-prose space-y-3 text-[0.9375rem] leading-[1.6] text-ink-muted">
          {bullets.map((b) => (
            <li class="flex gap-3">
              <span class="mt-[0.7em] h-px w-4 shrink-0 bg-ink" aria-hidden="true" />
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
