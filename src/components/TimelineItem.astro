---
interface Props {
  title: string;
  org?: string;
  dates: string;
  location: string;
  bullets?: string[];
  featured?: boolean;
  compact?: boolean;
}

const {
  title,
  org,
  dates,
  location,
  bullets = [],
  featured = false,
  compact = false,
} = Astro.props;

const orgLine = org?.trim();
---

<li class="relative pl-8 sm:pl-10">
  <span
    class="absolute left-[7px] top-2 h-full w-px bg-gradient-to-b from-accent/50 via-line to-transparent sm:left-[9px]"
    aria-hidden="true"
  />
  <span
    class="absolute left-0 top-2 flex h-[18px] w-[18px] items-center justify-center rounded-full border border-accent/40 bg-surface shadow-[0_0_0_4px_rgba(12,16,24,0.9)] sm:h-5 sm:w-5"
    aria-hidden="true"
  >
    <span class="h-2 w-2 rounded-full bg-accent/80" />
  </span>

  <div
    class:list={[
      "rounded-xl border border-line bg-surface-overlay/40",
      compact ? "px-4 py-3.5 sm:px-5 sm:py-4" : "p-5 sm:p-6",
      featured && "ring-1 ring-accent/10",
    ]}
  >
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <div>
        <h3 class="text-base font-semibold text-ink">{title}</h3>
        {
          orgLine && (
            <p class="text-sm text-accent/90">{orgLine}</p>
          )
        }
      </div>
      <p class="font-mono text-[11px] uppercase tracking-wider text-ink-faint">
        {dates}
      </p>
    </div>
    <p class="mt-2 font-mono text-xs text-ink-muted">{location}</p>
    {
      bullets.length > 0 && (
        <ul class="mt-5 space-y-2.5 text-sm leading-snug text-ink-muted">
          {bullets.map((b) => (
            <li class="flex gap-2">
              <span
                class="mt-2 h-px w-3 shrink-0 bg-accent/40"
                aria-hidden="true"
              />
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
