---
import JsonSnippet from "@/components/origenlab/JsonSnippet.astro";

const monorepoApps = [
  {
    app: "apps/web",
    role: "Astro / Tailwind public marketing site (origenlab.cl)",
  },
  {
    app: "apps/email-pipeline",
    role: "Python / uv Gmail–PST ingest, SQLite marts, outbound safety, reports, Streamlit, mutation scripts (no FastAPI)",
  },
  {
    app: "apps/api",
    role: "GET-only FastAPI operator API on :8001 (SQLite-first; optional mirror reporting)",
  },
  {
    app: "apps/dashboard",
    role: "React / Vite read-only operator dashboard",
  },
];

const mirrorDashboardSummary = {
  scope: "canonical",
  contact_count: 412,
  organization_count: 198,
  opportunity_signal_count: 1203,
};

const leadProspectItem = {
  prospect_key: "lab-ejemplo-cl",
  classification: "equipment_buyer",
  region: "Los Ríos",
  score: 72,
  blocked: false,
};

const operatorRoutes = [
  { method: "GET", path: "/health", purpose: "Liveness (SQLite operator plane)" },
  { method: "GET", path: "/operator/status", purpose: "Operator verdict / staleness" },
  { method: "GET", path: "/cases/warm", purpose: "Warm commercial case queue (sanitized previews)" },
  { method: "GET", path: "/opportunities/equipment", purpose: "Equipment-first operator queue manifest" },
  { method: "GET", path: "/contacts/{email}", purpose: "Read-only contact profile (Today side panel)" },
];

const mirrorRoutes = [
  { method: "GET", path: "/mirror/dashboard/summary", purpose: "KPI counts (?scope=canonical|archive)" },
  { method: "GET", path: "/mirror/meta/dashboard-sync", purpose: "Last mirror sync run" },
  { method: "GET", path: "/mirror/classification/summary", purpose: "Label distribution (heuristic QA)" },
  { method: "GET", path: "/mirror/commercial/purchase-events", purpose: "Confirmed purchase orders" },
  { method: "GET", path: "/mirror/outbound/readiness", purpose: "Mirror pre-flight for outbound review" },
  { method: "GET", path: "/mirror/leads/prospects", purpose: "Lead research prospects (filters, read-only)" },
  { method: "GET", path: "/mirror/leads/summary", purpose: "Lead intel rollup" },
  { method: "GET", path: "/mirror/health/dependencies", purpose: "Postgres + SQLite ping (when mirror enabled)" },
];

const operatorRunbook = [
  "Gmail / IMAP ingest → SQLite archive (apps/email-pipeline)",
  "build_business_mart.py --rebuild (contacts, orgs, signals)",
  "Optional: promote confirmed OCs → commercial_purchase_* (SQLite)",
  "Optional: sync_dashboard_postgres_mirror.py → Postgres reporting mirror",
  "uvicorn origenlab_api.main:app --port 8001 (apps/api)",
  "npm run dev in apps/dashboard (React :5173) — smoke hits /health + /operator/status",
];

const dashboardSections = [
  "Today",
  "Inbox triage",
  "Opportunities",
  "Deals",
  "Prospectos",
  "Catálogo",
  "Suppliers",
  "Tenders",
  "Payments / logistics",
  "Contacts",
  "System",
];
---

<section
  class="case-study-section scroll-mt-28 rounded-2xl border border-line/80 bg-surface-overlay/20 px-5 py-8 sm:px-8 sm:py-10"
  aria-labelledby="origenlab-ops-heading"
>
  <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent/90">
    Backend &amp; dashboard
  </p>
  <h2
    id="origenlab-ops-heading"
    class="mt-2 text-xl font-semibold tracking-tight text-ink sm:text-2xl"
    style="text-wrap: pretty;"
  >
    Email pipeline, operator API, mirror reporting, and dashboard
  </h2>
  <p class="mt-4 max-w-3xl text-pretty leading-relaxed text-ink-muted">
    <strong class="font-medium text-ink">SQLite stays authoritative</strong> for
    ingest, mart rebuilds, outbound safety, and mutation scripts in{" "}
    <span class="font-mono text-xs text-accent/90">apps/email-pipeline</span>.
    <strong class="font-medium text-ink">apps/api</strong> exposes a{" "}
    <strong class="font-medium text-ink">read-only</strong> operator API on port{" "}
    <strong class="font-medium text-ink">8001</strong> — no ingest, no send, no record
    mutation. An <strong class="font-medium text-ink">optional Postgres mirror</strong>{" "}
    feeds mirror reporting routes (<span class="font-mono text-xs text-accent/90"
      >/mirror/*</span
    >) when synced; a Postgres URL is not required for the normal SQLite operator API.
  </p>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-xl border border-line/70 bg-surface/50 p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-ink">apps/email-pipeline</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        PST / Gmail → SQLite archive → rebuildable business marts → outbound safety
        sidecars → optional commercial OC promotion → optional mirror sync. Streamlit
        remains the deep SQLite review surface; all writes stay here.
      </p>
      <ol class="olab-runbook mt-3 list-none space-y-1.5 text-[11px] leading-snug text-accent/85">
        {
          operatorRunbook.map((step, i) => (
            <li class="flex gap-2">
              <span class="shrink-0 font-mono text-ink-faint">{i + 1}.</span>
              <code class="min-w-0 font-mono">{step}</code>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="rounded-xl border border-line/70 bg-surface/50 p-4 sm:p-5">
      <h3 class="text-sm font-semibold text-ink">apps/dashboard</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        Multi-section React operator dashboard—read-only, human-reviewed outreach.
        Sections include Today, inbox triage, opportunities, deals, Prospectos (lead
        intelligence), catálogo, suppliers, tenders, payments/logistics, contacts, and
        system. Consumes <span class="font-mono text-xs text-accent/90">apps/api</span>;
        does not send mail or replace SQLite truth.
      </p>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {
          dashboardSections.map((label) => (
            <li>
              <span class="rounded-full border border-line/80 bg-surface-overlay/60 px-2 py-0.5 font-mono text-[10px] text-ink-muted">
                {label}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-xs leading-relaxed text-ink-faint">
        Prospectos: SQLite lead research imports → optional Postgres{" "}
        <span class="font-mono text-accent/90">lead_intel</span> mirror →{" "}
        <span class="font-mono text-accent/90">GET /mirror/leads/*</span> with filters
        (classification, sector, region, campaign bucket, score, blocked).
      </p>
    </div>
  </div>

  <div class="mt-10">
    <h3 class="text-sm font-semibold text-ink">Monorepo layout</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">
      Four deployable apps; marketing never calls the pipeline at runtime. Sensitive
      mail and SQLite live under <span class="font-mono text-xs text-accent/90"
        >~/data/origenlab-email/</span
      >, not in git.
    </p>
    <div class="case-study-table-wrap mt-4 overflow-x-auto rounded-xl border border-line/80">
      <table class="w-full min-w-0 border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-line/80 bg-surface-overlay/50 font-mono text-[10px] uppercase tracking-wider text-ink-faint">
            <th class="px-4 py-2.5 pr-4">App</th>
            <th class="px-4 py-2.5">Role</th>
          </tr>
        </thead>
        <tbody class="text-ink-muted">
          {
            monorepoApps.map((row) => (
              <tr class="border-b border-line/40 last:border-0">
                <td class="px-4 py-2.5 pr-4 align-top font-mono text-xs text-accent/90">
                  {row.app}
                </td>
                <td class="px-4 py-2.5 text-xs leading-snug">{row.role}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-10">
    <h3 class="text-sm font-semibold text-ink">Optional Postgres mirror</h3>
    <div
      class="mt-4 rounded-xl border border-line/70 bg-surface/50 px-4 py-4 sm:px-5 sm:py-5"
    >
      <p class="text-sm leading-relaxed text-ink-muted">
        <strong class="font-medium text-ink">Optional Postgres mirror:</strong> reporting-only
        schemas for archive, mart, outbound, commercial, reporting, and{" "}
        <span class="font-mono text-xs text-accent/90">lead_intel</span>. Alembic manages
        DDL when the mirror is used; loaders copy from SQLite (eventually consistent).
        Mirror routes are read-only under{" "}
        <span class="font-mono text-xs text-accent/90">/mirror/*</span>; operator day-to-day
        routes read SQLite directly.
      </p>
    </div>
  </div>

  <div class="mt-10">
    <h3 class="text-sm font-semibold text-ink">apps/api — health &amp; operator plane</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">
      SQLite-first on port <span class="font-mono text-xs text-accent/90">8001</span>.
      <span class="font-mono text-xs text-accent/90">GET /health</span> confirms liveness;{" "}
      <span class="font-mono text-xs text-accent/90">GET /operator/status</span> surfaces
      operator verdict. All routes are GET-only—no autonomous send, no ingest from HTTP.
    </p>
  </div>

  <div class="mt-10">
    <h3 class="text-sm font-semibold text-ink">Representative API payloads</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">
      Sanitized illustrative shapes only—full route lists stay in the tables below.
    </p>
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <JsonSnippet
        compact
        title="GET /mirror/dashboard/summary"
        data={mirrorDashboardSummary}
        caption="Optional Postgres mirror reporting—not SQLite operational truth."
      />
      <JsonSnippet
        compact
        title="GET /mirror/leads/prospects (item)"
        data={leadProspectItem}
        caption="Read-only Prospectos; human review before outreach."
      />
    </div>
  </div>

  <div class="case-study-table-wrap mt-10 min-w-0 overflow-x-auto">
    <h3 class="text-sm font-semibold text-ink">Operator API (SQLite-first)</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">
      Core routes for Today, triage, and contact drilldown. All GET.
    </p>
    <table class="mt-4 w-full min-w-0 border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-line/80 font-mono text-[10px] uppercase tracking-wider text-ink-faint">
          <th class="py-2 pr-4">Method</th>
          <th class="py-2 pr-4">Path</th>
          <th class="py-2">Purpose</th>
        </tr>
      </thead>
      <tbody class="text-ink-muted">
        {
          operatorRoutes.map((r) => (
            <tr class="border-b border-line/40">
              <td class="py-2.5 pr-4 font-mono text-xs text-accent/90">{r.method}</td>
              <td class="break-all py-2.5 pr-4 font-mono text-xs text-teal-100/80">
                {r.path}
              </td>
              <td class="py-2.5 text-xs leading-snug">{r.purpose}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="case-study-table-wrap mt-10 min-w-0 overflow-x-auto">
    <h3 class="text-sm font-semibold text-ink">Mirror reporting API (optional Postgres)</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">
      When Postgres is synced, dashboard sections can consume mirror reporting (routes
      under <span class="font-mono text-xs text-accent/90">/mirror/*</span>). Still
      read-only—no writes, no send path.
    </p>
    <table class="mt-4 w-full min-w-0 border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-line/80 font-mono text-[10px] uppercase tracking-wider text-ink-faint">
          <th class="py-2 pr-4">Method</th>
          <th class="py-2 pr-4">Path</th>
          <th class="py-2">Purpose</th>
        </tr>
      </thead>
      <tbody class="text-ink-muted">
        {
          mirrorRoutes.map((r) => (
            <tr class="border-b border-line/40">
              <td class="py-2.5 pr-4 font-mono text-xs text-accent/90">{r.method}</td>
              <td class="break-all py-2.5 pr-4 font-mono text-xs text-teal-100/80">
                {r.path}
              </td>
              <td class="py-2.5 text-xs leading-snug">{r.purpose}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
