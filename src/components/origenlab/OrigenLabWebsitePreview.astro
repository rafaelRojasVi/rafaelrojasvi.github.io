---
/** Visual mock inspired by origenlab.cl (May 2026 redesign) — no private HTML embedded */
import OrigenLabHeaderLockup from "@/components/origenlab/logo/OrigenLabHeaderLockup.astro";

const LIVE = "https://origenlab.cl";
const plusTexture = `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")`;
---

<div
  class="olab-site-mock min-w-0 max-w-full overflow-hidden rounded-xl border border-line bg-surface-overlay/60 shadow-card"
  aria-label="Visual mock of the OrigenLab public website"
>
  <div
    class="flex items-center gap-2 border-b border-line/80 bg-[#1a2332] px-2.5 py-2 sm:px-3"
  >
    <span class="flex shrink-0 gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]/90" />
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]/90" />
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]/90" />
    </span>
    <a
      href={LIVE}
      target="_blank"
      rel="noopener noreferrer"
      class="ml-1 flex min-w-0 flex-1 items-center gap-1.5 truncate rounded-md bg-black/25 px-2.5 py-1.5 text-left font-mono text-[10px] text-slate-300 transition hover:bg-black/40 hover:text-white focus-visible:outline focus-visible:ring-2 focus-visible:ring-accent"
    >
      <span class="shrink-0 text-slate-500" aria-hidden="true">https://</span>
      <span class="truncate">origenlab.cl</span>
    </a>
  </div>

  <div
    class="max-h-[min(75vh,780px)] overflow-y-auto overflow-x-hidden bg-slate-50 text-slate-900"
  >
    <div class="min-w-0 max-w-full">
      <!-- Sticky-style header -->
      <header class="border-b border-teal-950/30 bg-[#042f2e]">
        <div
          class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 sm:px-4"
        >
          <a
            href={LIVE}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 rounded-md focus-visible:outline focus-visible:ring-2 focus-visible:ring-teal-200/80"
            aria-label="OrigenLab"
          >
            <OrigenLabHeaderLockup decorative />
          </a>
          <nav
            class="flex flex-wrap items-center justify-end gap-x-2.5 gap-y-1 text-[10px] font-semibold text-teal-100/95 sm:gap-x-3 sm:text-[11px]"
            aria-hidden="true"
          >
            <span>Nosotros</span>
            <span>Productos</span>
            <span>Marcas</span>
            <span>Contacto</span>
            <span
              class="rounded-md bg-teal-500/90 px-2 py-0.5 text-white shadow-sm"
            >
              Cotizar
            </span>
          </nav>
        </div>
      </header>

      <!-- Split hero -->
      <section
        class="relative overflow-hidden bg-gradient-to-br from-[#042f2e] via-[#0f4c47] to-[#115e59] text-white"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.06]"
          style={`background-image: ${plusTexture};`}
          aria-hidden="true"
        />
        <div class="relative grid gap-6 px-3 py-8 sm:px-5 md:grid-cols-2 md:items-center md:py-10">
          <div>
            <p
              class="text-[10px] font-semibold uppercase tracking-[0.2em] text-teal-200/95"
            >
              OrigenLab
            </p>
            <h2
              class="mt-2 text-lg font-bold leading-tight tracking-tight sm:text-xl"
            >
              Equipos para laboratorio, cotizados con criterio técnico
            </h2>
            <p class="mt-2 text-[11px] leading-relaxed text-teal-50/95 sm:text-xs">
              Laboratorios de servicio, universidades, clínicas e industria en todo
              Chile.
            </p>
            <ul
              class="mt-3 flex flex-wrap gap-1.5"
              aria-label="Confianza comercial"
            >
              {
                [
                  "Valdivia · cobertura nacional",
                  "Cotización mail/WhatsApp",
                  "Asesoría previa",
                ].map((chip) => (
                  <li>
                    <span class="rounded-full border border-white/20 bg-white/10 px-2 py-0.5 text-[9px] font-medium text-teal-50">
                      {chip}
                    </span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-4 flex flex-wrap gap-2">
              <span
                class="rounded-lg bg-white px-3 py-1.5 text-[10px] font-bold text-[#0f766e]"
              >
                Solicitar cotización
              </span>
              <span
                class="rounded-lg border border-white/70 px-3 py-1.5 text-[10px] font-semibold"
              >
                Ver productos
              </span>
            </div>
          </div>
          <!-- Featured product panel -->
          <div
            class="rounded-xl border border-slate-200/80 bg-white p-3 text-slate-900 shadow-md"
          >
            <p class="text-[9px] font-semibold uppercase tracking-wide text-[#0f766e]">
              Ortoalresa
            </p>
            <p class="mt-0.5 text-xs font-bold text-slate-900">Digicen 22 R</p>
            <div
              class="mt-2 flex min-h-[5.5rem] items-center justify-center rounded-lg bg-gradient-to-b from-slate-50 to-slate-100 text-[10px] text-slate-400"
            >
              Imagen de producto
            </div>
            <p class="mt-2 text-[9px] leading-snug text-slate-500">
              Microcentrífuga refrigerada · ficha y PDF en sitio
            </p>
            <div class="mt-2 flex flex-wrap gap-1">
              {
                ["Alimentos", "QC", "Clínico"].map((c) => (
                  <span class="rounded bg-teal-50 px-1.5 py-0.5 text-[8px] font-medium text-teal-800">
                    {c}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Commercial lines -->
      <section class="border-b border-slate-200 bg-white px-3 py-6 sm:px-5">
        <h3 class="text-sm font-bold text-[#042f2e]">
          Líneas disponibles para cotización
        </h3>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          <li class="rounded-xl border border-slate-200 bg-gradient-to-b from-white to-slate-50/80 p-3">
            <p class="text-[9px] font-semibold uppercase tracking-wide text-[#0f766e]">
              Ortoalresa
            </p>
            <p class="mt-1 text-xs font-bold">Centrífugas Ortoalresa</p>
            <p class="mt-1 text-[10px] leading-snug text-slate-600">
              Cinco modelos en catálogo · comparación en /productos/centrifugas
            </p>
          </li>
          <li class="rounded-xl border border-slate-200 bg-gradient-to-b from-white to-slate-50/80 p-3">
            <p class="text-[9px] font-semibold uppercase tracking-wide text-[#0f766e]">
              SERVA
            </p>
            <p class="mt-1 text-xs font-bold">Reactivos e insumos SERVA</p>
            <p class="mt-1 text-[10px] leading-snug text-slate-600">
              BlueSlick™, TEMED, REPEL-SILANE en página de marca
            </p>
          </li>
        </ul>
      </section>

      <!-- Categories -->
      <section class="bg-slate-50 px-3 py-6 sm:px-5">
        <h3 class="text-sm font-bold text-[#042f2e]">
          Explore por necesidad del laboratorio
        </h3>
        <ul class="mt-3 grid gap-2 sm:grid-cols-3">
          {
            ["Alimentos", "Control de calidad", "Laboratorio clínico"].map(
              (cat) => (
                <li class="rounded-lg border border-slate-200 bg-white p-2.5 text-center">
                  <span class="text-[10px] font-bold text-slate-800">{cat}</span>
                </li>
              ),
            )
          }
        </ul>
      </section>

      <!-- Process -->
      <section class="border-t border-slate-200 bg-white px-3 py-5 sm:px-5">
        <h3 class="text-xs font-bold text-[#042f2e]">Cómo trabajamos</h3>
        <ol class="mt-3 grid gap-2 sm:grid-cols-4">
          {
            [
              "Cuéntenos su necesidad",
              "Revisamos alternativas",
              "Enviamos cotización",
              "Coordinamos condiciones",
            ].map((step, i) => (
              <li class="text-center">
                <span
                  class="mx-auto flex h-6 w-6 items-center justify-center rounded-full bg-[#0f766e] text-[10px] font-bold text-white"
                >
                  {i + 1}
                </span>
                <p class="mt-1 text-[9px] font-semibold leading-tight text-slate-700">
                  {step}
                </p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <div
    class="flex flex-col gap-1 border-t border-line/80 bg-surface-overlay/50 px-3 py-2.5 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left"
  >
    <a
      href={LIVE}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[10px] text-accent transition hover:text-ink"
    >
      Sitio en producción · origenlab.cl →
    </a>
    <span class="font-mono text-[10px] uppercase tracking-wider text-ink-faint">
      Astro 5 + Tailwind 4 · catálogo tipado
    </span>
  </div>
</div>
