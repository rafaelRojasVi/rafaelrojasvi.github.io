---
interface Props {
  title?: string;
  active?: boolean;
  class?: string;
  /** Visual recipe: classic grey OS chrome vs editorial color distortion */
  variant?: "classic" | "editorial";
}

const {
  title = "Untitled",
  active = true,
  class: className = "",
  variant = "classic",
} = Astro.props;

const isEditorial = variant === "editorial";
---

<section
  class:list={["dl-win", isEditorial && "dl-win--editorial", !active && "dl-win--inactive", className]}
  aria-label={`Window: ${title}`}
>
  <header class:list={["dl-win__titlebar", active ? "dl-win__titlebar--active" : "dl-win__titlebar--idle"]}>
    <span class="dl-win__title">{title}</span>
    <div class="dl-win__controls" aria-hidden="true">
      <span class="dl-win__ctl">_</span>
      <span class="dl-win__ctl">□</span>
      <span class="dl-win__ctl dl-win__ctl--close">×</span>
    </div>
  </header>
  <div class="dl-win__body">
    <slot />
  </div>
</section>

<style>
  .dl-win {
    display: flex;
    flex-direction: column;
    border-radius: 0;
    background: var(--dl-grey-face);
    box-shadow:
      inset 1px 1px 0 var(--dl-grey-hilite),
      inset -1px -1px 0 var(--dl-grey-dkshadow),
      inset 2px 2px 0 var(--dl-grey-face),
      inset -2px -2px 0 var(--dl-grey-shadow),
      4px 6px 0 rgba(0, 0, 0, 0.35);
    min-width: 0;
    max-width: 100%;
  }

  .dl-win--editorial {
    background: var(--dl-purple);
    box-shadow:
      inset 2px 2px 0 #b366ff,
      inset -2px -2px 0 #3a0a80,
      6px 8px 0 var(--dl-yellow);
    color: var(--dl-offwhite);
  }

  .dl-win--inactive {
    opacity: 0.92;
  }

  .dl-win__titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 3px 4px 3px 6px;
    min-height: 22px;
    font-family: var(--dl-ui);
    font-size: 12px;
    font-weight: 700;
    user-select: none;
  }

  .dl-win__titlebar--active {
    background: linear-gradient(90deg, #000080 0%, #1084d0 100%);
    color: #fff;
  }

  .dl-win__titlebar--idle {
    background: #808080;
    color: #d4d4d4;
  }

  .dl-win--editorial .dl-win__titlebar--active {
    background: linear-gradient(90deg, var(--dl-magenta) 0%, var(--dl-cobalt) 55%, var(--dl-acid) 100%);
    color: var(--dl-black);
    font-family: var(--dl-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
  }

  .dl-win__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .dl-win__controls {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }

  .dl-win__ctl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 14px;
    font-size: 10px;
    line-height: 1;
    background: var(--dl-grey-face);
    color: var(--dl-black);
    box-shadow:
      inset 1px 1px 0 var(--dl-grey-hilite),
      inset -1px -1px 0 var(--dl-grey-dkshadow);
    font-family: var(--dl-ui);
    font-weight: 700;
  }

  .dl-win--editorial .dl-win__ctl {
    background: var(--dl-yellow);
    box-shadow:
      inset 1px 1px 0 #fff6a0,
      inset -1px -1px 0 #998800;
  }

  .dl-win__body {
    padding: 10px 12px 12px;
    min-width: 0;
  }

  .dl-win--editorial .dl-win__body {
    background: var(--dl-near-black);
    color: var(--dl-offwhite);
    margin: 2px;
    box-shadow: var(--dl-bevel-in);
  }
</style>
