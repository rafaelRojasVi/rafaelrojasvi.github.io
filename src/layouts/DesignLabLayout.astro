---
import "@/styles/design-system.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Design Lab",
  description = "Visual prototype — portfolio redesign experiment. Not production chrome.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="design-lab-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Rafael Rojas</title>
    <meta name="description" content={description} />
    <style is:global>
      /* Isolate lab from production body defaults; do not touch global.css */
      html.design-lab-root,
      html.design-lab-root body {
        margin: 0;
        padding: 0;
        min-height: 100%;
      }
    </style>
  </head>
  <body class="design-lab">
    <slot />
  </body>
</html>
