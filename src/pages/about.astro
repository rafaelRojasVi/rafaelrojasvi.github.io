---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
import AgentSession from "@/components/AgentSession.astro";

const title = "About";
const description = profile.seo.about;
const paragraphs = profile.aboutExtended.split("\n\n");
---

<BaseLayout title={title} description={description}>
  <section class="page pt-10 sm:pt-14 lg:pt-16" aria-labelledby="about-heading">
    <h1 id="about-heading" class="display text-[clamp(3rem,9vw,7rem)]">About</h1>
    <div class="rule mt-8 sm:mt-12"></div>
  </section>

  <section class="page mt-10 sm:mt-14">
    <div class="grid-12">
      <aside class="col-span-4 sm:col-span-8 lg:col-span-4">
        <dl class="grid grid-cols-2 gap-x-4 gap-y-6 lg:sticky lg:top-24 lg:grid-cols-1">
          <div>
            <dt class="meta">Based in</dt>
            <dd class="mt-1 text-sm text-ink">{profile.location}</dd>
          </div>
          <div>
            <dt class="meta">Pronouns</dt>
            <dd class="mt-1 text-sm text-ink">{profile.pronouns}</dd>
          </div>
          <div>
            <dt class="meta">Languages</dt>
            <dd class="mt-1 text-sm text-ink">
              {profile.humanLanguages.map((l) => `${l.name} (${l.level})`).join(", ")}
            </dd>
          </div>
          <div>
            <dt class="meta">Outside work</dt>
            <dd class="mt-1 text-sm text-ink">{profile.interests.join(", ")}</dd>
          </div>
          <div class="col-span-2 lg:col-span-1">
            <dt class="meta">Contact</dt>
            <dd class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-sm">
              <a class="link" href={`mailto:${profile.contact.email}`}>Email</a>
              <a class="link" href={profile.contact.github} rel="noopener noreferrer">GitHub</a>
              <a class="link" href={profile.contact.linkedIn} rel="noopener noreferrer">LinkedIn</a>
            </dd>
          </div>
        </dl>
      </aside>

      <div class="col-span-4 mt-12 sm:col-span-8 lg:col-span-7 lg:col-start-6 lg:mt-0">
        <p class="text-pretty text-2xl font-normal leading-[1.3] tracking-tight text-ink sm:text-3xl">
          {paragraphs[0]}
        </p>
        <div class="prose-ed mt-10">
          {paragraphs.slice(1).map((p) => <p>{p}</p>)}
        </div>

        <figure class="mt-16 border-l-2 border-accent pl-6 sm:pl-8" data-reveal>
          <blockquote class="text-pretty text-xl italic leading-[1.4] tracking-tight text-ink sm:text-2xl">
            {profile.headline}
          </blockquote>
          <figcaption class="mt-5 text-sm text-ink-muted">
            {profile.headlineAttribution},
            <cite class="not-italic">{profile.headlineSource}</cite>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="page mt-28 sm:mt-36" aria-labelledby="skills-heading">
    <div class="rule" data-reveal="rule"></div>
    <h2 id="skills-heading" class="pt-5 text-3xl font-medium tracking-tight sm:text-4xl" data-reveal>
      Stack
    </h2>
    <dl class="mt-10 grid gap-x-8 gap-y-10 sm:mt-14 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        (
          [
            ["Languages", profile.skills.languages],
            ["Backend", profile.skills.backend],
            ["Databases", profile.skills.databases],
            ["Tools", profile.skills.tools],
            ["Practices", profile.skills.concepts],
            ["Agents", profile.skills.agents],
          ] as const
        ).map(([group, items]) => (
          <div class="border-t border-line pt-4" data-reveal>
            <dt class="meta">{group}</dt>
            <dd class="mt-3 text-sm leading-[1.7] text-ink">
              {items.join(", ")}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="page mt-28 sm:mt-36" aria-labelledby="agents-heading">
    <div class="rule" data-reveal="rule"></div>
    <h2 id="agents-heading" class="pt-5 text-3xl font-medium tracking-tight sm:text-4xl" data-reveal>
      Working with agents
    </h2>
    <div class="grid-12 mt-10 sm:mt-14">
      <div class="col-span-4 sm:col-span-8 lg:col-span-6" data-reveal>
        <p class="text-pretty text-xl font-normal leading-[1.35] tracking-tight text-ink sm:text-2xl">
          {profile.agentsWork.lead}
        </p>
        <div class="prose-ed mt-8">
          {profile.agentsWork.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {
            profile.agentsWork.links.map((l) => (
              <li>
                <a class="link" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="col-span-4 mt-10 sm:col-span-8 lg:col-span-5 lg:col-start-8 lg:mt-0"
        data-reveal
        style="--d: 120ms"
      >
        <AgentSession />
      </div>
    </div>
  </section>
</BaseLayout>
