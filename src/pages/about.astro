---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SystemDiagram from "@/components/SystemDiagram.astro";
import { profile } from "@/data/profile";

const title = "About";
const description =
  "About Rafael Rojas — backend engineer in Valdivia, Chile; interests, contact, and how they work.";
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div>
        <SectionHeading
          eyebrow="Hello"
          title="Human, technical, quietly stubborn about clarity"
        />
        <div class="mt-8 space-y-5 text-pretty text-base leading-relaxed text-ink-muted">
          {profile.aboutExtended.split("\n\n").map((para) => <p>{para}</p>)}
        </div>
      </div>
      <SystemDiagram variant="hero" class="lg:sticky lg:top-28" />
    </div>

    <section class="mt-16" aria-labelledby="speak-heading">
      <SectionHeading
        id="speak-heading"
        eyebrow="Languages"
        title="How I communicate"
      />
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          profile.humanLanguages.map((l) => (
            <li class="rounded-xl border border-line bg-surface-overlay/40 px-4 py-3">
              <p class="font-semibold text-ink">{l.name}</p>
              <p class="font-mono text-xs text-ink-muted">{l.level}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14" aria-labelledby="interests-heading">
      <SectionHeading
        id="interests-heading"
        eyebrow="Away from the terminal"
        title="Interests"
        description="The non-code side — it shows up in how I write, how I listen, and how much ambiguity I can sit with while still shipping."
      />
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          profile.interests.map((i) => (
            <li class="rounded-full border border-line bg-surface/80 px-3 py-1.5 font-mono text-xs text-ink-muted">
              {i}
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="mt-14 rounded-2xl border border-line/80 bg-gradient-to-br from-surface-overlay/80 to-surface/90 p-8 sm:p-10"
      aria-labelledby="contact-heading"
    >
      <SectionHeading
        id="contact-heading"
        eyebrow="Contact"
        title="Let’s talk about backend work"
        description="Open to remote and hybrid roles. Prefer email for first contact."
      />
      <div class="mt-8 flex flex-col gap-4 font-mono text-sm sm:flex-row sm:flex-wrap sm:items-center">
        <a
          class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 font-semibold uppercase tracking-wider text-surface transition hover:bg-ink"
          href={`mailto:${profile.contact.email}`}
        >
          Email {profile.contact.email}
        </a>
        <a
          class="text-ink-muted underline-offset-4 transition hover:text-accent hover:underline"
          href={profile.contact.github}
          rel="noopener noreferrer"
        >
          GitHub (placeholder)
        </a>
        <a
          class="text-ink-muted underline-offset-4 transition hover:text-accent hover:underline"
          href={profile.contact.linkedIn}
          rel="noopener noreferrer"
        >
          LinkedIn (placeholder)
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
