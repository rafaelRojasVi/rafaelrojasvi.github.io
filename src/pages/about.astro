---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SystemDiagram from "@/components/SystemDiagram.astro";
import { profile } from "@/data/profile";

const title = "About";
const description = profile.seo.about;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 pb-24 pt-12 sm:px-6 sm:pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-start lg:gap-14">
      <div>
        <SectionHeading
          eyebrow="About"
          title="Backend engineer, detail-first"
          description="A bit more context than the homepage—still short. I’m happiest where HTTP meets databases and vendor APIs, with tests on the sharp edges."
        />
        <div class="mt-10 space-y-5 text-pretty text-base leading-[1.7] text-ink-muted">
          {profile.aboutExtended.split("\n\n").map((para) => <p>{para}</p>)}
        </div>
      </div>
      <SystemDiagram variant="hero" class="lg:sticky lg:top-28" />
    </div>

    <section class="mt-20" aria-labelledby="speak-heading">
      <SectionHeading
        id="speak-heading"
        eyebrow="Languages"
        title="Communication"
      />
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          profile.humanLanguages.map((l) => (
            <li class="rounded-xl border border-line bg-surface-overlay/40 px-4 py-3">
              <p class="font-semibold text-ink">{l.name}</p>
              <p class="font-mono text-xs text-ink-muted">{l.level}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="interests-heading">
      <SectionHeading
        id="interests-heading"
        eyebrow="Outside engineering"
        title="Interests"
        description="Not filler—these are the same attention patterns I bring to long debugging sessions and to writing clear runbooks."
      />
      <ul class="mt-8 flex flex-wrap gap-2">
        {
          profile.interests.map((i) => (
            <li class="rounded-full border border-line bg-surface/80 px-3 py-1.5 font-mono text-xs text-ink-muted">
              {i}
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="mt-16 rounded-2xl border border-line/80 bg-gradient-to-br from-surface-overlay/80 to-surface/90 px-6 py-8 sm:px-10 sm:py-10"
      aria-labelledby="contact-heading"
    >
      <SectionHeading
        id="contact-heading"
        eyebrow="Contact"
        title="Hiring or collaborating?"
        description="Email is best for a first message. Open to remote and hybrid backend roles."
      />
      <div class="mt-8 flex flex-col gap-4 font-mono text-sm sm:flex-row sm:flex-wrap sm:items-center">
        <a
          class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 font-semibold uppercase tracking-wider text-surface transition hover:bg-ink"
          href={`mailto:${profile.contact.email}`}
        >
          {profile.contact.email}
        </a>
        <a
          class="text-ink-muted underline-offset-4 transition hover:text-accent hover:underline"
          href={profile.contact.github}
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a
          class="text-ink-muted underline-offset-4 transition hover:text-accent hover:underline"
          href={profile.contact.linkedIn}
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
