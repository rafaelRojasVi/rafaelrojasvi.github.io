    .mini-home--b .mini-home__cta {
      position: relative;
      z-index: 5;
      max-width: 52%;
      margin-top: 2.5rem;
    }

    /* C — EDITORIAL: role as graphic, window cuts left / overlaps stack */
    .mini-home--c {
      min-height: min(94vh, 760px);
      padding-left: clamp(1.25rem, 3vw, 2rem);
      padding-right: clamp(1.5rem, 5vw, 3.5rem);
    }

    .mini-home--c .mini-home__slab {
      display: block;
      left: clamp(1rem, 4vw, 2.5rem);
      top: 17.5rem;
      width: min(16rem, 34%);
      height: 4.25rem;
      background: var(--dl-yellow);
      box-shadow:
        5px 5px 0 var(--dl-magenta),
        10px 10px 0 var(--dl-purple);
      transform: rotate(-1.5deg);
      z-index: 1;
    }

    .mini-home--c .mini-home__role--c {
      margin-top: -0.35rem;
    }

    .mini-home--c .mini-home__slash--c {
      right: auto;
      left: 58%;
      top: 6%;
      color: var(--dl-yellow);
      opacity: 0.14;
      transform: rotate(12deg);
    }

    .mini-home--c .mini-home__float {
      position: absolute;
      left: clamp(-0.45rem, -1vw, 0);
      top: 21.5rem;
      bottom: auto;
      margin-top: 0;
      width: min(21rem, 36%);
      transform: rotate(2.5deg);
      z-index: 4;
      box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.45);
    }

    .mini-home--c .mini-home__cta--c {
      margin-left: auto;
      margin-right: 0;
      margin-top: 3.5rem;
      justify-content: flex-end;
      max-width: 22rem;
      position: relative;
      z-index: 5;
    }

    .mini-home--c .mini-home__name {
      max-width: 78%;
      position: relative;
      z-index: 2;
    }

    .mini-home--c .mini-home__stack {
      max-width: 48%;
      position: relative;
      z-index: 5;
    }
  }

  /* —— Mobile: collapse overlaps, keep attitude —— */
  @media (max-width: 899px) {
    .mini-home {
      min-height: auto;
      padding-bottom: 2rem;
    }

    .mini-home__float {
      transform: none !important;
      position: relative !important;
      left: auto !important;
      right: auto !important;
      top: auto !important;
      bottom: auto !important;
      width: auto !important;
      max-width: 100%;
      margin-top: 1.5rem;
      z-index: 1 !important;
    }

    .mini-home__plane,
    .mini-home__slab {
      display: none !important;
    }

    .mini-home--b .mini-home__name,
    .mini-home--b .mini-home__stack,
    .mini-home--b .mini-home__cta,
    .mini-home--c .mini-home__name,
    .mini-home--c .mini-home__stack {
      max-width: none;
    }

    .mini-home--c .mini-home__cta--c {
      margin-left: 0;
      justify-content: flex-start;
      max-width: none;
    }

    .mini-home__role--c {
      max-width: none;
    }

    .mini-home__role--c .role-eng {
      margin-left: 1rem;
    }

    .type-num {
      position: static;
      display: block;
      margin-top: 0.5rem;
      font-size: 4rem;
      opacity: 0.7;
      mix-blend-mode: normal;
    }
  }

  /* —— D / INTERNET 2001 —— */
  .d-lede {
    margin: -0.35rem 0 1.1rem;
    max-width: 42rem;
    font-family: Verdana, Geneva, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    color: var(--dl-offwhite);
  }

  .d-test {
    margin: 0.85rem 0 0;
    font-size: 11px;
    color: var(--dl-acid);
    max-width: 44rem;
  }

  .inet-stage {
    position: relative;
    padding: 11px 7px 14px;
    background: var(--dl-cobalt-deep);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35);
  }

  .inet-desktop {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.04) 2px,
        rgba(0, 0, 0, 0.04) 3px
      );
    pointer-events: none;
    z-index: 0;
  }

  .inet-browser {
    position: relative;
    z-index: 1;
    max-width: 920px;
    margin: 0 auto;
    background: var(--dl-grey-face);
    box-shadow: var(--dl-bevel-out);
    font-family: Tahoma, Verdana, "MS Sans Serif", sans-serif;
    font-size: 11px;
    color: var(--dl-black);
  }

  .inet-titlebar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 3px 3px 3px 5px;
    background: linear-gradient(90deg, #000080 0%, #1084d0 100%);
    color: #fff;
    font-family: Tahoma, sans-serif;
    font-size: 11px;
    font-weight: 700;
    user-select: none;
  }

  .inet-titlebar__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    background:
      linear-gradient(135deg, #fff 0 2px, transparent 2px),
      linear-gradient(45deg, #39ff14 0 40%, #0033cc 40% 70%, #ffe600 70%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }

  .inet-titlebar__text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .inet-titlebar__ctl {
    display: flex;
    gap: 2px;
  }

  .inet-titlebar__ctl span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 14px;
    background: var(--dl-grey-face);
    color: #000;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    box-shadow:
      inset 1px 1px 0 #fff,
      inset -1px -1px 0 #404040;
  }

  .inet-menubar {
    display: flex;
    flex-wrap: wrap;
    gap: 0 11px;
    padding: 2px 6px 3px;
    background: var(--dl-grey-face);
    border-bottom: 1px solid var(--dl-grey-shadow);
    font-size: 11px;
  }

  .inet-menubar span {
    cursor: default;
  }

  .inet-toolbar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 5px 5px;
    background: var(--dl-grey-face);
    border-bottom: 1px solid var(--dl-grey-hilite);
    box-shadow: inset 0 -1px 0 var(--dl-grey-shadow);
  }

  .inet-toolbar__label {
    font-size: 11px;
    flex-shrink: 0;
  }

  .inet-address {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 4px;
    background: #fff;
    font-family: "Courier New", Courier, monospace;
    font-size: 11px;
  }

  .inet-address__ico {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    background: linear-gradient(180deg, #39ff14 0 50%, #0033cc 50%);
    box-shadow: inset 0 0 0 1px #808080;
  }

  .inet-address__url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .inet-go {
    flex-shrink: 0;
    padding: 2px 10px !important;
    font-size: 11px !important;
    font-family: Tahoma, sans-serif !important;
    font-weight: 400 !important;
  }

  .inet-page {
    background: #fff;
    color: #000;
    border-top: 1px solid var(--dl-grey-shadow);
  }

  .inet-layout {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 0;
    min-height: 340px;
  }

  .inet-side {
    padding: 7px 7px 11px;
    background: #d4d0c8;
    border-right: 1px solid var(--dl-grey-shadow);
    box-shadow: inset -1px 0 0 var(--dl-grey-hilite);
  }

  .inet-side__head {
    margin: 0 0 5px;
    font-family: Verdana, Geneva, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #000080;
  }

  .inet-nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .inet-nav__a {
    display: block;
    padding: 2px 3px;
    font-family: Verdana, Geneva, sans-serif;
    font-size: 11px;
    color: #0000ee;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .inet-nav__a:hover {
    color: #ff00aa;
    background: #fff;
  }

  .inet-nav__a--here {
    font-weight: 700;
    color: #000;
    text-decoration: none;
    background: #fff;
    box-shadow: var(--dl-bevel-in);
  }

  .inet-hr {
    margin: 9px 0 7px;
    border: 0;
    border-top: 1px solid var(--dl-grey-shadow);
    border-bottom: 1px solid var(--dl-grey-hilite);
  }

  .inet-sys {
    margin: 0;
    font-family: "Courier New", Courier, monospace;
    font-size: 10px;
    line-height: 1.4;
  }

  .inet-sys div {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 3px;
    margin-bottom: 3px;
  }

  .inet-sys dt {
    margin: 0;
    color: #404040;
  }

  .inet-sys dd {
    margin: 0;
    color: #000;
  }

  .inet-led {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 3px;
    vertical-align: middle;
    background: var(--dl-acid);
    box-shadow:
      inset 1px 1px 0 #9dff88,
      inset -1px -1px 0 #1a8800,
      0 0 0 1px #404040;
  }

  .inet-led--sm {
    width: 6px;
    height: 6px;
  }

  .inet-counter {
    color: #000080;
    font-weight: 700;
  }

  .inet-badge {
    margin-top: 11px;
    width: 88px;
    height: 31px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 2px 3px;
    background:
      repeating-linear-gradient(
        90deg,
        #0033cc 0 2px,
        #001a80 2px 4px
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0 2px,
        rgba(57, 255, 20, 0.25) 2px 3px
      );
    border: 1px solid #000;
    box-shadow: inset 1px 1px 0 #39ff14;
  }

  .inet-badge__px {
    width: 9px;
    height: 9px;
    background: var(--dl-yellow);
    box-shadow: 1px 1px 0 #000;
  }

  .inet-badge__cap {
    font-family: "Courier New", monospace;
    font-size: 9px;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    padding: 0 2px;
  }

  .inet-tiny {
    margin: 9px 0 0;
    font-family: "Courier New", monospace;
    font-size: 9px;
    line-height: 1.35;
    color: #404040;
  }

  .inet-main {
    padding: 11px 14px 16px 12px;
    font-family: Verdana, Geneva, Arial, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    background: #fff;
  }

  .inet-name {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #000080;
    line-height: 1.15;
  }

  .inet-role {
    margin: 3px 0 0;
    font-family: "Courier New", Courier, monospace;
    font-size: 12px;
    color: #008000;
  }

  .inet-intro {
    margin: 11px 0 0;
    max-width: 46ch;
    font-size: 12px;
    color: #000;
  }

  .inet-inset {
    margin-top: 11px;
    padding: 5px 7px 6px;
    background: #f7f7f0;
    max-width: 220px;
  }

  .inet-inset__label {
    margin: 0 0 3px;
    font-family: "Courier New", monospace;
    font-size: 10px;
    color: #808080;
  }

  .inet-skills {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: "Courier New", Courier, monospace;
    font-size: 12px;
    line-height: 1.4;
    color: #000;
  }

  .inet-h {
    margin: 14px 0 0;
    font-family: Tahoma, Verdana, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #000;
    letter-spacing: 0.06em;
  }

  .inet-dots {
    margin: 2px 0 7px;
    font-family: "Courier New", monospace;
    font-size: 10px;
    color: #808080;
    letter-spacing: 0.12em;
    overflow: hidden;
    white-space: nowrap;
  }

  .inet-projects {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inet-projects li {
    margin: 0 0 11px;
    padding: 0 0 7px;
    border-bottom: 1px dotted #808080;
  }

  .inet-projects li:last-child {
    border-bottom: 0;
  }

  .inet-proj__id {
    margin: 0;
    font-family: Tahoma, Verdana, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #000080;
  }

  .inet-proj__stack {
    margin: 2px 0 3px;
    font-family: "Courier New", monospace;
    font-size: 11px;
    color: #404040;
  }

  .inet-link {
    font-family: Verdana, Geneva, sans-serif;
    font-size: 11px;
    color: #0000ee;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .inet-link:hover {
    color: #ff00aa;
  }

  .inet-link--visited {
    color: #551a8b;
  }

  .inet-more {
    margin: 7px 0 0;
    font-size: 11px;
    color: #404040;
  }

  .inet-statusbar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 1px 3px;
    background: var(--dl-grey-face);
    border-top: 1px solid var(--dl-grey-hilite);
    box-shadow: inset 0 1px 0 var(--dl-grey-shadow);
    font-family: Tahoma, sans-serif;
    font-size: 10px;
    color: #000;
    min-height: 18px;
  }

  .inet-statusbar__done,
  .inet-statusbar__zone,
  .inet-statusbar__online {
    padding: 1px 5px;
    box-shadow: var(--dl-bevel-in);
    background: var(--dl-grey-inset);
  }

  .inet-statusbar__sep {
    width: 3px;
  }

  .inet-statusbar__grow {
    flex: 1;
  }

  .inet-statusbar span:nth-child(3) {
    padding: 1px 5px;
    box-shadow: var(--dl-bevel-in);
    background: var(--dl-grey-inset);
  }

  /* Previous experiments accordion */
  .prev-exp {
    margin-top: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.18);
  }

  .prev-exp__sum {
    cursor: pointer;
    padding: 0.65rem 0.85rem;
    font-family: var(--dl-mono);
    font-size: 11px;
    color: var(--dl-offwhite);
    list-style: none;
  }

  .prev-exp__sum::-webkit-details-marker {
    display: none;
  }

  .prev-exp__sum::before {
    content: "[+] ";
    color: var(--dl-acid);
  }

  .prev-exp[open] .prev-exp__sum::before {
    content: "[-] ";
  }

  .prev-exp__body {
    padding: 0 0.75rem 1.5rem;
    border-top: 1px solid rgba(57, 255, 20, 0.25);
  }

  /* Mobile: stack columns, keep browser shell readable */
  @media (max-width: 700px) {
    .inet-layout {
      grid-template-columns: 1fr;
    }

    .inet-side {
      border-right: 0;
      border-bottom: 1px solid var(--dl-grey-shadow);
      box-shadow: none;
      padding-bottom: 9px;
    }

    .inet-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 5px 9px;
    }

    .inet-sys {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3px 11px;
    }

    .inet-sys div {
      grid-template-columns: auto 1fr;
    }

    .inet-badge {
      display: none;
    }

    .inet-menubar {
      display: none;
    }

    .inet-name {
      font-size: 20px;
    }

    .inet-statusbar {
      flex-wrap: wrap;
      gap: 3px;
    }
  }

  @media (min-width: 701px) and (max-width: 1024px) {
    .inet-layout {
      grid-template-columns: 118px 1fr;
    }

    .inet-browser {
      max-width: 100%;
    }
  }

  /* —— E / INTERNET 2002 HYBRID · PHASE 1F ERA PALETTE —— */
  #variant-e {
    --era-web-deep: #001a66;
    --era-web-mid: #002b7f;
    --era-web: #003399;
    --era-navy: #000080;
    --era-grey: #c0c0c0;
    --era-grey-warm: #d4d0c8;
    --era-paper: #e8e5d8;
    --era-link: #0000ee;
    --era-visited: #551a8b;
    --era-term: #00a85a;
    --era-term-dk: #007a42;
    --era-cyan: #00a0b0;
    --era-gold: #c9a227;
    --era-gold-hi: #d6b13f;
    --era-orange: #c96b2c;
    --era-teal: #0b4f4c;
    --era-ink: #0a1516;
    --era-offwhite: #e8e5d8;
    /* Interaction-state accents (mostly hover/focus/active) */
    --hot-green: #39ff14;
    --hot-yellow: #ffe600;
    --hot-purple: #9b30ff;
    --hot-magenta: #e6007a;
    --hot-cobalt: #1a66ff;
  }

  #variant-e .d-test--era {
