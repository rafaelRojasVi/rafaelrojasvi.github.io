---
import DesignLabLayout from "@/layouts/DesignLabLayout.astro";
import WinWindow from "@/components/ui/WinWindow.astro";
import BevelButton from "@/components/ui/BevelButton.astro";
---

<DesignLabLayout title="Design Lab — Phase 1G">
  <div class="dl-page">
    <header class="dl-lab-header">
      <div>
        <h1>Design Lab</h1>
        <p>
          Phase 1G — interaction states + classic cursors on locked E. Resting = 1F era; hover reveals hotter
          accents. Production untouched.
        </p>
      </div>
      <a class="dl-back" href="/">← portfolio home</a>
    </header>

    <!-- ═══════ NAME FONT STUDY · PHASE 2A.3 (temporary) ═══════ -->
    <section class="dl-section" id="name-fonts" aria-labelledby="name-fonts-label">
      <p class="dl-section-num">NAME FONT STUDY · PHASE 2A.3</p>
      <h2 id="name-fonts-label" class="dl-section-title">RAFAEL / ROJAS letterform specimens</h2>
      <p class="d-lede">
        Temporary name-only study. System fonts only. Cream / gold match production identity. Do not treat as
        production until one specimen is selected.
      </p>

      <div class="nf-grid">
        <article class="nf-spec" aria-labelledby="nf-a-label">
          <header class="nf-spec__meta">
            <h3 id="nf-a-label">A — Impact / Haettenschweiler</h3>
            <p class="dl-mono">Impact, Haettenschweiler, Arial Narrow, sans-serif</p>
          </header>
          <div class="nf-field">
            <p class="nf-name nf-name--a">
              <span class="nf-name__a">RAFAEL</span>
              <span class="nf-name__b">ROJAS</span>
            </p>
          </div>
        </article>

        <article class="nf-spec" aria-labelledby="nf-b-label">
          <header class="nf-spec__meta">
            <h3 id="nf-b-label">B — Trebuchet MS heavy</h3>
            <p class="dl-mono">Trebuchet MS, Geneva, Arial, sans-serif · 900</p>
          </header>
          <div class="nf-field">
            <p class="nf-name nf-name--b">
              <span class="nf-name__a">RAFAEL</span>
              <span class="nf-name__b">ROJAS</span>
            </p>
          </div>
        </article>

        <article class="nf-spec" aria-labelledby="nf-c-label">
          <header class="nf-spec__meta">
            <h3 id="nf-c-label">C — Arial Black + hard shadow</h3>
            <p class="dl-mono">Arial Black, Arial Bold, Impact, Arial · hard offset shadow</p>
          </header>
          <div class="nf-field">
            <p class="nf-name nf-name--c">
              <span class="nf-name__a">RAFAEL</span>
              <span class="nf-name__b">ROJAS</span>
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══════ E — INTERNET 2002 / HYBRID (PRIMARY · 1G interactions) ═══════ -->
    <section class="dl-section" id="variant-e" aria-labelledby="variant-e-label">
      <p class="dl-section-num">E / PRIMARY · PHASE 1G</p>
      <h2 id="variant-e-label" class="dl-section-title">Internet 2002 / Hybrid</h2>
      <p class="d-lede">
        Structure + era palette locked. This pass: classic cursors (fine pointer only), link/nav/project/GO
        interaction states, and hot accents that appear mainly on hover/focus/active.
      </p>

      <div class="inet-stage dl-crt" aria-label="Internet 2002 hybrid homepage study">
        <div class="inet-desktop" aria-hidden="true"></div>

        <div class="inet-browser hyb-browser">
          <div class="inet-titlebar">
            <span class="inet-titlebar__icon" aria-hidden="true"></span>
            <span class="inet-titlebar__text"
              >rafaelrojasvi.github.io - Microsoft Internet Explorer</span
            >
            <div class="inet-titlebar__ctl" aria-hidden="true">
              <span>_</span><span>□</span><span class="inet-titlebar__x">×</span>
            </div>
          </div>

          <div class="inet-menubar" aria-label="Menu">
            <span><u>F</u>ile</span>
            <span><u>E</u>dit</span>
            <span><u>V</u>iew</span>
            <span>F<u>a</u>vorites</span>
            <span><u>H</u>elp</span>
          </div>

          <div class="inet-toolbar">
            <span class="inet-toolbar__label">Address</span>
            <div class="inet-address dl-bevel-in">
              <span class="inet-address__ico" aria-hidden="true"></span>
              <span class="inet-address__url"
                >http://rafaelrojasvi.github.io/index.html</span
              >
            </div>
            <BevelButton class="inet-go">Go</BevelButton>
          </div>

          <div class="inet-page hyb-page">
            <div class="inet-layout hyb-layout">
              <aside class="inet-side hyb-side">
                <p class="inet-side__head">Navigation</p>
                <nav class="inet-nav" aria-label="Site">
                  <a class="inet-nav__a inet-nav__a--here" href="/">HOME</a>
                  <a class="inet-nav__a" href="/projects">PROJECTS</a>
                  <a class="inet-nav__a" href="/experience">EXPERIENCE</a>
                  <a class="inet-nav__a" href="/about">ABOUT</a>
                  <a class="inet-nav__a" href="mailto:rafarojasv6@gmail.com">CONTACT</a>
                </nav>

                <hr class="inet-hr" />

                <p class="inet-side__head">System</p>
                <dl class="inet-sys">
                  <div>
                    <dt>status</dt>
                    <dd><span class="inet-led" aria-hidden="true"></span> ONLINE</dd>
                  </div>
                  <div>
                    <dt>location</dt>
                    <dd>VALDIVIA_CL</dd>
                  </div>
                  <div>
                    <dt>build</dt>
                    <dd>2026.08</dd>
                  </div>
                  <div>
                    <dt>visitor</dt>
                    <dd class="inet-counter">0027</dd>
                  </div>
                </dl>

                <div class="hyb-px-wrap" aria-hidden="true">
                  <img
                    class="hyb-px"
                    src="/design-lab/px-crt.svg"
                    width="32"
                    height="32"
                    alt=""
                  />
                  <span class="hyb-px-cap">sys_crt.gif</span>
                </div>

                <div class="hyb-meter" aria-hidden="true">
                  <span class="hyb-meter__cap">sig</span>
                  <span class="hyb-meter__track"
                    ><span class="hyb-meter__fill"></span></span
                  >
                </div>

                <div class="inet-badge hyb-badge" aria-hidden="true">
                  <span class="hyb-badge__dot"></span>
                  <span class="hyb-badge__text">RAFA<br />ONLINE</span>
                </div>

                <p class="inet-tiny">
                  last updated<br />
                  09 Aug 2026
                </p>
              </aside>

              <main class="inet-main hyb-main">
                <div class="hyb-id">
                  <p class="hyb-path">C:\USERS\RAFA\WWW\INDEX.HTM</p>
                  <div class="hyb-id__row">
                    <h3 class="hyb-name">
                      <span class="hyb-name__a">RAFAEL</span>
                      <span class="hyb-name__b">ROJAS</span>
                    </h3>
                    <span class="hyb-new" aria-hidden="true">NEW!</span>
                  </div>
                  <p class="hyb-role">[ SOFTWARE_ENGINEER ]</p>
                  <div class="hyb-check" aria-hidden="true"></div>
                </div>

                <section class="hyb-mod hyb-mod--profile">
                  <header class="hyb-mod__bar hyb-mod__bar--cobalt">
                    <span>PROFILE / INTRO</span>
                    <span class="hyb-mod__meta">about.txt</span>
                  </header>
                  <div class="hyb-mod__body">
                    <p>
                      Backend engineer in Valdivia, Chile. First Class Honours CS. I build APIs,
                      automation, and data tools — the kind another engineer can extend without a
                      séance.
                    </p>
                  </div>
                </section>

                <section class="hyb-mod hyb-mod--skills">
                  <header class="hyb-mod__bar hyb-mod__bar--metal">
                    <span>SKILLS.TXT</span>
                    <span class="hyb-mod__meta">5 entries</span>
                  </header>
                  <div class="hyb-mod__body hyb-skills-body">
                    <ul class="hyb-skills">
                      <li>&gt; Python</li>
                      <li>&gt; Elixir</li>
                      <li>&gt; APIs</li>
                      <li>&gt; automation</li>
                      <li>&gt; backend systems</li>
                    </ul>
                  </div>
                </section>

                <section class="hyb-mod hyb-mod--work">
                  <header class="hyb-mod__bar hyb-mod__bar--work">
                    <span>SELECTED_WORK</span>
                    <span class="hyb-mod__meta">dir / projects</span>
                  </header>
                  <div class="hyb-mod__body hyb-work-body">
                    <article class="hyb-proj hyb-proj--a">
                      <div class="hyb-proj__head">
                        <span class="hyb-proj__id">[01] ORIGENLAB</span>
                        <span class="hyb-proj__status"
                          ><span class="inet-led inet-led--sm" aria-hidden="true"></span> LIVE</span
                        >
                      </div>
                      <div class="hyb-proj__inner">
                        <img
                          class="hyb-px hyb-px--lab"
                          src="/design-lab/px-lab.svg"
                          width="32"
                          height="32"
                          alt=""
                          aria-hidden="true"
                        />
                        <div class="hyb-proj__copy">
                          <p class="hyb-proj__stack">Python / FastAPI / SQLite / automation</p>
                          <p class="hyb-proj__blurb">
                            Lab automation API — ingest, validate, emit. Durable SQLite state.
                          </p>
                          <p>
                            <a class="inet-link" href="/projects/origenlab">view_project →</a>
                          </p>
                        </div>
                      </div>
                    </article>

                    <article class="hyb-proj hyb-proj--b">
                      <div class="hyb-proj__head">
                        <span class="hyb-proj__id">[02] LEDGERBANK API</span>
                        <span class="hyb-proj__status hyb-proj__status--warn">STABLE</span>
                      </div>
                      <p class="hyb-proj__stack">Elixir / Phoenix / PostgreSQL</p>
                      <p class="hyb-proj__blurb">
                        Banking-adjacent ledger endpoints with explicit money-edge tests.
                      </p>
                      <p>
                        <a class="inet-link inet-link--visited" href="/projects/ledger-bank-api"
                          >view_project →</a
                        >
                      </p>
                    </article>
                  </div>
                </section>

                <section class="hyb-mod hyb-mod--links">
                  <header class="hyb-mod__bar hyb-mod__bar--links">
                    <span>CONTACT / LINKS</span>
                    <span class="hyb-mod__meta">also</span>
                  </header>
                  <div class="hyb-mod__body">
                    <p class="hyb-also">
                      <a class="inet-link" href="/projects/tattoo-booking-bot"
                        >tattoo-booking-bot.html</a
                      >
                      ·
                      <a class="inet-link" href="/projects/misinformation-classifier"
                        >misinfo-classifier.html</a
                      >
                      ·
                      <a class="inet-link" href="/experience">resume.txt</a>
                      ·
                      <a class="inet-link" href="mailto:rafarojasv6@gmail.com">email.exe</a>
                    </p>
                  </div>
                </section>
              </main>
            </div>
          </div>

          <div class="inet-statusbar" role="status">
            <span class="inet-statusbar__done">Done</span>
            <span class="inet-statusbar__sep" aria-hidden="true"></span>
            <span>4 objects</span>
            <span class="inet-statusbar__sep" aria-hidden="true"></span>
            <span class="inet-statusbar__zone">Internet zone</span>
            <span class="inet-statusbar__grow"></span>
            <span class="inet-statusbar__online"
              ><span class="inet-led inet-led--sm" aria-hidden="true"></span> ONLINE</span
            >
          </div>
        </div>
      </div>

      <p class="d-test d-test--era dl-mono">
        1G tests: resting still 1F? · hover reveals hotter identity? · cursors fine-pointer only · keyboard focus
        obvious?
      </p>
    </section>

    <!-- ═══════ D — INTERNET 2001 (BASELINE) ═══════ -->
    <section class="dl-section" id="variant-d" aria-labelledby="variant-d-label">
      <p class="dl-section-num">D / AUTHENTICITY BASELINE</p>
      <h2 id="variant-d-label" class="dl-section-title">Internet 2001</h2>
      <p class="d-lede">
        Kept for side-by-side comparison. Structural grammar E inherits — intentionally plainer page interior.
      </p>

      <div class="inet-stage dl-crt" aria-label="Internet 2001 homepage study">
        <div class="inet-desktop" aria-hidden="true"></div>

        <div class="inet-browser">
          <!-- Title bar -->
          <div class="inet-titlebar">
            <span class="inet-titlebar__icon" aria-hidden="true"></span>
            <span class="inet-titlebar__text"
              >rafaelrojasvi.github.io - Microsoft Internet Explorer</span
            >
            <div class="inet-titlebar__ctl" aria-hidden="true">
              <span>_</span><span>□</span><span class="inet-titlebar__x">×</span>
            </div>
          </div>

          <!-- Menu -->
          <div class="inet-menubar" aria-label="Menu">
            <span><u>F</u>ile</span>
            <span><u>E</u>dit</span>
            <span><u>V</u>iew</span>
            <span>F<u>a</u>vorites</span>
            <span><u>H</u>elp</span>
          </div>

          <!-- Address -->
          <div class="inet-toolbar">
            <span class="inet-toolbar__label">Address</span>
            <div class="inet-address dl-bevel-in">
              <span class="inet-address__ico" aria-hidden="true"></span>
              <span class="inet-address__url"
                >http://rafaelrojasvi.github.io/index.html</span
              >
            </div>
            <BevelButton class="inet-go">Go</BevelButton>
          </div>

          <!-- Page -->
          <div class="inet-page">
            <div class="inet-layout">
              <aside class="inet-side">
                <p class="inet-side__head">Navigation</p>
                <nav class="inet-nav" aria-label="Site">
                  <a class="inet-nav__a inet-nav__a--here" href="/">HOME</a>
                  <a class="inet-nav__a" href="/projects">PROJECTS</a>
                  <a class="inet-nav__a" href="/experience">EXPERIENCE</a>
                  <a class="inet-nav__a" href="/about">ABOUT</a>
                  <a class="inet-nav__a" href="mailto:rafarojasv6@gmail.com">CONTACT</a>
                </nav>

                <hr class="inet-hr" />

                <p class="inet-side__head">System</p>
                <dl class="inet-sys">
                  <div>
                    <dt>status</dt>
                    <dd><span class="inet-led" aria-hidden="true"></span> ONLINE</dd>
                  </div>
                  <div>
                    <dt>location</dt>
                    <dd>VALDIVIA_CL</dd>
                  </div>
                  <div>
                    <dt>build</dt>
                    <dd>2026.08</dd>
                  </div>
                  <div>
                    <dt>visitor</dt>
                    <dd class="inet-counter">0027</dd>
                  </div>
                </dl>

                <div class="inet-badge" aria-hidden="true">
                  <span class="inet-badge__px"></span>
                  <span class="inet-badge__cap">88×31</span>
                </div>

                <p class="inet-tiny">
                  last updated<br />
                  09 Aug 2026
                </p>
              </aside>

              <main class="inet-main">
                <h3 class="inet-name">RAFAEL ROJAS</h3>
                <p class="inet-role">software engineer</p>

                <p class="inet-intro">
                  Backend engineer in Valdivia, Chile. First Class Honours CS. I build APIs,
                  automation, and data tools — the kind another engineer can extend without a
                  séance.
                </p>

                <div class="inet-inset dl-bevel-in">
                  <p class="inet-inset__label">~/skills.txt</p>
                  <ul class="inet-skills">
                    <li>&gt; Python</li>
                    <li>&gt; Elixir</li>
                    <li>&gt; APIs</li>
                    <li>&gt; automation</li>
                    <li>&gt; backend systems</li>
                  </ul>
                </div>

                <h4 class="inet-h">SELECTED PROJECTS</h4>
                <p class="inet-dots" aria-hidden="true">. . . . . . . . . . . . . . . . . . . .</p>

                <ol class="inet-projects">
                  <li>
                    <p class="inet-proj__id">[01] ORIGENLAB</p>
                    <p class="inet-proj__stack">Python / FastAPI / SQLite / automation</p>
                    <p>
                      <a class="inet-link" href="/projects/origenlab">view project →</a>
                    </p>
                  </li>
                  <li>
                    <p class="inet-proj__id">[02] LEDGERBANK API</p>
                    <p class="inet-proj__stack">Elixir / Phoenix / PostgreSQL</p>
                    <p>
                      <a class="inet-link inet-link--visited" href="/projects/ledger-bank-api"
                        >view project →</a
                      >
                    </p>
                  </li>
                </ol>

                <p class="inet-more">
                  Also:
                  <a class="inet-link" href="/projects/tattoo-booking-bot">tattoo-booking-bot.html</a>
                  ·
                  <a class="inet-link" href="/projects/misinformation-classifier"
                    >misinfo-classifier.html</a
                  >
                  ·
                  <a class="inet-link" href="/experience">resume.txt</a>
                </p>
              </main>
            </div>
          </div>

          <!-- Status bar -->
          <div class="inet-statusbar" role="status">
            <span class="inet-statusbar__done">Done</span>
            <span class="inet-statusbar__sep" aria-hidden="true"></span>
            <span>2 objects</span>
            <span class="inet-statusbar__sep" aria-hidden="true"></span>
            <span class="inet-statusbar__zone">Internet zone</span>
            <span class="inet-statusbar__grow"></span>
            <span class="inet-statusbar__online"
              ><span class="inet-led inet-led--sm" aria-hidden="true"></span> ONLINE</span
            >
          </div>
        </div>
      </div>

      <p class="d-test dl-mono">
        Design test: if accents were removed, would this still read as early-internet computation?
        Structure should carry identity — color only interrupts.
      </p>
    </section>

    <!-- Previous experiments collapsed -->
    <details class="prev-exp">
      <summary class="prev-exp__sum">
        Previous experiments (Phase 1A–1B) — A / B / C reference · not primary direction
      </summary>
      <div class="prev-exp__body">
        <section class="dl-section" aria-labelledby="raw-heading">
          <p class="dl-section-num">01 / RAW MATERIALS</p>
          <h2 id="raw-heading" class="dl-section-title">Palette · Type · Link</h2>

      <div class="raw-grid">
        <div class="raw-swatches" aria-label="Primary colors">
          <div class="swatch swatch--cobalt"><span>COBALT</span></div>
          <div class="swatch swatch--acid"><span>ACID</span></div>
          <div class="swatch swatch--magenta"><span>MAGENTA</span></div>
          <div class="swatch swatch--yellow"><span>YELLOW</span></div>
          <div class="swatch swatch--purple"><span>PURPLE</span></div>
          <div class="swatch swatch--grey"><span>UI GREY</span></div>
        </div>

        <div class="raw-pairings" aria-label="Deliberate pairings">
          <div class="pair pair--a">
            <span class="dl-pixel-label">PAIR A</span>
            <p class="pair__text">cobalt field · acid interrupt</p>
          </div>
          <div class="pair pair--b">
            <span class="dl-pixel-label">PAIR B</span>
            <p class="pair__text">magenta block · yellow type</p>
          </div>
          <div class="pair pair--c">
            <span class="dl-pixel-label">PAIR C</span>
            <p class="pair__text">paper · purple rule · black ink</p>
          </div>
        </div>

        <div class="raw-type">
          <p class="dl-pixel-label" style="color: var(--dl-yellow); margin: 0 0 0.75rem;">
            DISPLAY / MONO
          </p>
          <p class="dl-display type-blast" style="color: var(--dl-offwhite); margin: 0;">
            RAFA<br />ROJAS
          </p>
          <p class="type-mono-row dl-mono">
            C:\PORTFOLIO\&gt; SELECTED_WORK.EXE
          </p>
          <p class="type-symbols" aria-hidden="true">※ ▒▓░ ■ ◆ → ←</p>
          <p class="type-num" aria-hidden="true">98</p>
          <p style="margin: 1rem 0 0;">
            <a class="dl-link dl-link--invert" href="#mini-home">underlined hyperlink treatment →</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════ 02 WINDOW STUDIES ═══════ -->
    <section class="dl-section" aria-labelledby="win-heading">
      <p class="dl-section-num">02 / WINDOW STUDIES</p>
      <h2 id="win-heading" class="dl-section-title">Authentic ↔ Distorted</h2>

      <div class="win-studies">
        <WinWindow title="readme.txt — Notepad" active>
          <p class="dl-pixel-label" style="margin: 0 0 0.5rem; color: #404040;">
            CLASSIC GREY
          </p>
          <div class="dl-bevel-in inset-field">
            <p class="dl-mono" style="margin: 0; font-size: 13px; color: #000;">
              Backend systems with explicit validation, durable state, and tests on the edges that move money or messages.
            </p>
          </div>
          <p style="margin: 0.75rem 0; font-size: 13px;">
            See also: <a class="dl-link" href="#mini-home">about.txt</a>
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <BevelButton href="#mini-home">OK</BevelButton>
            <BevelButton pressed>Cancel</BevelButton>
          </div>
        </WinWindow>

        <WinWindow title="SIGNAL / EDITORIAL" variant="editorial" active>
          <p class="dl-pixel-label" style="margin: 0 0 0.5rem; color: var(--dl-acid);">
            RECOLORED
          </p>
          <div class="inset-editorial">
            <p class="dl-mono" style="margin: 0; font-size: 13px; color: var(--dl-offwhite);">
              The OS chrome is raw material — not the product. Type and color do the talking.
            </p>
          </div>
          <p style="margin: 0.85rem 0;">
            <a class="dl-link dl-link--invert" href="#crt">open crt study</a>
          </p>
          <BevelButton href="#mini-home" variant="editorial">RUN STUDY</BevelButton>
        </WinWindow>

        <WinWindow title="inactive — Properties" active={false} class="win-inactive-study">
          <p class="dl-mono" style="margin: 0; font-size: 12px; color: #404040;">
            Idle title bar for comparison. Decorative controls are not focusable.
          </p>
        </WinWindow>
      </div>
    </section>

    <!-- ═══════ 03 TEXTURE / CRT ═══════ -->
    <section class="dl-section" id="crt" aria-labelledby="crt-heading">
      <p class="dl-section-num">03 / TEXTURE · CRT</p>
      <h2 id="crt-heading" class="dl-section-title">Raw vs Signal</h2>

      <div class="crt-compare">
        <article class="crt-panel crt-panel--raw">
          <h3 class="dl-pixel-label" style="margin: 0 0 0.75rem; color: var(--dl-black);">
            RAW SIGNAL
          </h3>
          <p class="crt-copy">
            Messy inputs become structured outputs: ingest, validate, emit. No scanlines. Flat field. Baseline readability check.
          </p>
          <p class="dl-mono" style="margin: 0.75rem 0 0; font-size: 12px;">
            status: clean · gain: 0db
          </p>
        </article>

        <article class="crt-panel crt-panel--crt dl-crt dl-moire">
          <h3 class="dl-pixel-label" style="margin: 0 0 0.75rem; color: var(--dl-acid);">
            CRT SIGNAL
          </h3>
          <p class="crt-copy crt-copy--on-dark">
            Messy inputs become structured outputs: ingest, validate, emit. Scanlines + soft vignette + light moiré — personality without burying the copy.
          </p>
          <p class="dl-mono" style="margin: 0.75rem 0 0; font-size: 12px; color: var(--dl-acid);">
            status: degraded · gain: +3db
          </p>
        </article>
      </div>
    </section>

