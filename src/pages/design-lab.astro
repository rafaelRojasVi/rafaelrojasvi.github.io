  }

  .hyb-page {
    background: var(--era-web-deep);
  }

  .hyb-layout {
    min-height: 420px;
  }

  .hyb-side {
    background: #b8b4ac;
    background-image: linear-gradient(180deg, #d0ccc4 0%, #b8b4ac 40%, #a8a49c 100%);
  }

  .hyb-browser .inet-nav__a:hover {
    color: var(--era-visited);
    background: #fff;
  }

  .hyb-browser .inet-led {
    background: var(--era-term);
    box-shadow:
      inset 1px 1px 0 #4fd68a,
      inset -1px -1px 0 var(--era-term-dk),
      0 0 0 1px #404040;
  }

  .hyb-browser .inet-address__ico {
    background: linear-gradient(180deg, var(--era-term) 0 50%, var(--era-navy) 50%);
  }

  .hyb-browser .inet-titlebar__icon {
    background:
      linear-gradient(135deg, #fff 0 2px, transparent 2px),
      linear-gradient(45deg, var(--era-term) 0 40%, var(--era-navy) 40% 70%, var(--era-gold) 70%);
  }

  .hyb-browser .inet-link {
    color: var(--era-link);
  }

  .hyb-browser .inet-link:hover {
    color: var(--era-orange);
  }

  .hyb-browser .inet-link--visited {
    color: var(--era-visited);
  }

  .hyb-main {
    padding: 9px 11px 13px 10px;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.045) 2px,
        rgba(0, 0, 0, 0.045) 3px
      ),
      linear-gradient(180deg, var(--era-web-mid) 0%, var(--era-web-deep) 55%, #001040 100%);
    color: var(--era-offwhite);
    border-left: 1px solid #000040;
  }

  .hyb-id {
    margin: 0 0 9px;
    padding: 7px 7px 5px;
    border: 1px solid #003399;
    background: linear-gradient(180deg, #002b7f 0%, #001a66 100%);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.1);
  }

  .hyb-path {
    margin: 0 0 5px;
    font-family: "Courier New", Courier, monospace;
    font-size: 9px;
    color: var(--era-cyan);
    letter-spacing: 0.02em;
  }

  .hyb-id__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 7px;
  }

  .hyb-name {
    margin: 0;
    line-height: 0.88;
  }

  .hyb-name__a,
  .hyb-name__b {
    display: block;
    font-family: Arial Black, "Arial Bold", Impact, Arial, sans-serif;
    font-size: clamp(48px, 6.2vw, 68px);
