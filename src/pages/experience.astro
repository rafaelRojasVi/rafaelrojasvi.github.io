---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TimelineItem from "@/components/TimelineItem.astro";
import { profile, experience, otherRoles, education } from "@/data/profile";

const title = "Experience";
const description = profile.seo.experience;
---

<BaseLayout title={title} description={description}>
  <section class="page pt-10 sm:pt-14 lg:pt-16" aria-labelledby="exp-heading">
    <div class="grid-12 items-end">
      <h1
        id="exp-heading"
        class="display col-span-4 text-[clamp(3rem,9vw,7rem)] sm:col-span-8 lg:col-span-8"
      >
        Experience
      </h1>
      <p class="col-span-4 mt-4 max-w-prose text-pretty text-base leading-[1.55] text-ink-muted sm:col-span-8 lg:col-span-4 lg:mt-0 lg:pb-2">
        Backend roles first: what shipped, with which stack, and where I owned
        delivery. Education and earlier work follow.
      </p>
    </div>
    <div class="rule mt-8 sm:mt-12"></div>
  </section>

  <section class="page mt-6" aria-labelledby="work-heading">
    <h2 id="work-heading" class="sr-only">Work</h2>
    <ul>
      {
        experience.map((item) => (
          <TimelineItem
            title={item.title}
            org={item.org}
            orgUrl={item.orgUrl}
            logo={item.logo}
            dates={item.dates}
            location={item.location}
            bullets={[...item.bullets]}
            featured={item.featured}
          />
        ))
      }
    </ul>
  </section>

  <section class="page mt-24 sm:mt-32" aria-labelledby="education-heading">
    <div class="rule"></div>
    <h2 id="education-heading" class="pt-5 text-3xl font-medium tracking-tight sm:text-4xl">
      Education
    </h2>
    <ul class="mt-10">
      {
        education.map((ed) => (
          <li class="grid-12 border-t border-line py-7 sm:py-9" data-reveal>
            <div class="col-span-4 sm:col-span-8 lg:col-span-3">
              <p class="font-mono text-xs tabular-nums text-ink">{ed.dates}</p>
            </div>
            <div class="col-span-4 mt-3 sm:col-span-8 lg:col-span-9 lg:mt-0">
              <h3 class="text-xl font-medium tracking-tight text-ink sm:text-2xl">{ed.degree}</h3>
              <p class="mt-1 text-base text-ink-muted">{ed.school}</p>
              {ed.focus && (
                <p class="mt-4 text-sm text-ink-muted">
                  <span class="text-ink">Focus:</span> {ed.focus.join(", ")}
                </p>
              )}
              {ed.grades && (
                <dl class="mt-6 grid max-w-xl grid-cols-2 gap-x-8 gap-y-4">
                  {ed.grades.map((g) => (
                    <div class="border-t border-line pt-2">
                      <dt class="text-sm text-ink-muted">{g.course}</dt>
                      <dd class="mt-1 font-mono text-2xl tabular-nums text-ink">{g.score}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {ed.detail && (
                <p class="mt-4 max-w-prose text-sm leading-[1.6] text-ink-muted">{ed.detail}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page mt-24 sm:mt-32" aria-labelledby="other-heading">
    <div class="rule"></div>
    <div class="grid-12 pt-5">
      <h2
        id="other-heading"
        class="col-span-4 text-3xl font-medium tracking-tight sm:col-span-8 sm:text-4xl lg:col-span-5"
      >
        Earlier roles
      </h2>
      <p class="col-span-4 mt-2 max-w-prose text-sm leading-[1.55] text-ink-muted sm:col-span-8 lg:col-span-6 lg:col-start-7 lg:mt-3">
        Customer-facing work in London. Short entries, but they are where
        pacing and calm explanations under pressure came from.
      </p>
    </div>
    <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-3">
      {
        otherRoles.map((role) => (
          <li class="border-t border-line pt-4" data-reveal>
            <p class="font-mono text-xs tabular-nums text-ink-faint">{role.dates}</p>
            <h3 class="mt-2 text-lg font-medium tracking-tight text-ink">{role.title}</h3>
            <p class="mt-1 text-sm text-ink-muted">{role.org}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
