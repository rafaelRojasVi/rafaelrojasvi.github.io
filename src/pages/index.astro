---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SystemDiagram from "@/components/SystemDiagram.astro";
import { profile } from "@/data/profile";
import { projects } from "@/data/projects";

const featured = projects;
const pageTitle = "Rafael Rojas";
const description = profile.seo.home;
---

<BaseLayout title={pageTitle} description={description}>
  <section
    class="relative mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pb-24 sm:pt-16 lg:pt-20"
  >
    <div class="grid gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:items-start lg:gap-14">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-accent/90">
          {profile.location} · open to remote / hybrid
        </p>
        <h1
          class="mt-4 text-balance text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.15rem] lg:leading-[1.08]"
        >
          {profile.name}
        </h1>
        <p class="mt-2 text-sm text-ink-muted">
          {profile.pronouns} · {profile.role}
        </p>
        <p
          class="mt-5 font-mono text-[13px] font-medium uppercase tracking-[0.14em] text-ink-muted sm:text-sm"
        >
          {profile.tagline}
        </p>
        <p
          class="mt-6 max-w-xl text-pretty text-lg leading-[1.65] text-ink-muted"
        >
          {profile.headline}
        </p>

        <div
          class="mt-8 border-l-2 border-accent/40 pl-5"
          aria-label="At a glance"
        >
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-faint">
            At a glance
          </p>
          <ul class="mt-3 space-y-2.5 text-sm leading-snug text-ink-muted">
            {profile.atAGlance.map((line) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent/70" />
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/projects"
            class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wider text-surface transition hover:bg-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Projects & case studies
          </a>
          <a
            href="/experience"
            class="inline-flex items-center justify-center rounded-lg border border-line bg-surface-overlay/50 px-5 py-2.5 font-mono text-sm font-medium uppercase tracking-wider text-ink transition hover:border-accent/35 hover:text-accent"
          >
            Experience
          </a>
          <a
            href={`mailto:${profile.contact.email}`}
            class="inline-flex items-center justify-center rounded-lg border border-transparent px-5 py-2.5 font-mono text-sm font-medium uppercase tracking-wider text-ink-muted underline-offset-4 transition hover:text-accent hover:underline"
          >
            Email
          </a>
        </div>
      </div>
      <SystemDiagram variant="hero" class="opacity-95 lg:mt-4" />
    </div>
  </section>

  <section
    class="mx-auto max-w-6xl border-t border-line/60 px-4 py-20 sm:px-6 sm:py-24"
    aria-labelledby="systems-heading"
  >
    <SectionHeading
      id="systems-heading"
      eyebrow="Selected work"
      title="Production backends & integrations"
      description="Four builds with different constraints: employed data/automation, freelance payments + messaging, academic ledger API, and an NLP evaluation project. Each write-up calls out stack, ownership, and where reliability mattered."
    />
    <div class="mt-12 grid gap-7 md:grid-cols-2 md:gap-8">
      {featured.map((p) => <ProjectCard project={p} featured />)}
    </div>
    <p class="mt-12 text-center sm:text-left">
      <a
        href="/projects"
        class="font-mono text-sm font-medium uppercase tracking-wider text-accent transition hover:text-ink"
      >
        All projects →
      </a>
    </p>
  </section>

  <section
    class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24"
    aria-labelledby="build-heading"
  >
    <SectionHeading
      id="build-heading"
      eyebrow="How I work"
      title="What I’m strongest at on a backend team"
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {
        profile.pillars.map((pillar) => (
          <div class="rounded-xl border border-line bg-surface-overlay/35 px-5 py-6 shadow-card transition hover:border-accent/20">
            <h3 class="text-base font-semibold leading-snug text-ink">
              {pillar.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              {pillar.body}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6 sm:pb-28">
    <div
      class="relative overflow-hidden rounded-2xl border border-line/80 bg-gradient-to-br from-surface-overlay/80 to-surface/90 px-6 py-8 sm:px-10 sm:py-10"
    >
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-56 w-56 rounded-full bg-accent/10 blur-3xl"
        aria-hidden="true"
      />
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent/90">
        Engineering default
      </p>
      <p
        class="relative mt-4 max-w-3xl text-pretty text-base leading-[1.7] text-ink-muted sm:text-lg"
      >
        {profile.personalNote}
      </p>
    </div>
  </section>
</BaseLayout>
