---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioBrowser from "@/components/PortfolioBrowser.astro";
import { profile } from "@/data/profile";
import { projects } from "@/data/projects";

const pageTitle = "Rafael Rojas";
const description = profile.seo.home;

const [firstName, ...restName] = profile.name.split(" ");
const lastName = restName.join(" ") || firstName;

/** Homepage selected work: production builds first (canonical project order). */
const selected = projects.filter((p) =>
  p.status.toLowerCase().includes("production"),
).slice(0, 2);

/** Concise skill scan from canonical profile.skills */
const skillLines = [
  ...profile.skills.languages.slice(0, 2),
  ...profile.skills.backend.slice(0, 2),
  ...profile.skills.databases.slice(0, 2),
  profile.skills.concepts.find((c) => c === "Automation") ?? "Automation",
  profile.skills.concepts.find((c) => c === "API integrations") ??
    "API integrations",
];

const roleToken = profile.role
  .toUpperCase()
  .replace(/[^A-Z0-9]+/g, "_")
  .replace(/^_|_$/g, "");

const intro = `${profile.homeEducation} ${profile.homeEducationLocation}. ${profile.atAGlance[0]}`;

function stackLine(stack: string[]): string {
  return stack.slice(0, 5).join(" / ");
}

function statusLabel(status: string): string {
  if (status.toLowerCase().includes("employed")) return "MODE: EMPLOYED";
  if (status.toLowerCase().includes("freelance")) return "MODE: FREELANCE";
  const mode = status.split("/")[0].trim().toUpperCase().slice(0, 12);
  return `MODE: ${mode}`;
}

/** Homepage listing blurb: shortest existing summary field (no new schema). */
function listingBlurb(project: (typeof projects)[number]): string {
  const candidates = [
    project.subtitle,
    project.shortDescription,
    project.engineeringFocus[0],
  ].filter((s): s is string => Boolean(s?.trim()));
  return candidates.reduce((a, b) => (a.length <= b.length ? a : b));
}
---

<BaseLayout title={pageTitle} description={description} shell="inet">
  <PortfolioBrowser
    address="http://rafaelrojasvi.github.io/index.html"
    objectsLabel={`${selected.length} objects`}
    nodeLabel="node 0027"
    buildLabel="2026.08"
    lastUpdated="09 Aug 2026"
  >
    <header class="inet-id">
      <p class="inet-path">C:\USERS\RAFA\WWW\INDEX.HTM</p>
      <div class="inet-id__row">
        <h1 class="inet-name">
          <span class="inet-name__a">{firstName}</span>
          <span class="inet-name__b">{lastName}</span>
        </h1>
      </div>
      <p class="inet-role">[ {roleToken} ]</p>
      <p class="inet-pronouns">{profile.pronouns} · {profile.location}</p>
      <div class="inet-check" aria-hidden="true"></div>
    </header>

    <section class="inet-mod" aria-labelledby="profile-heading">
      <header class="inet-mod__bar inet-mod__bar--cobalt">
        <h2 id="profile-heading">PROFILE / INTRO</h2>
        <span class="inet-mod__meta">about.txt</span>
      </header>
      <div class="inet-mod__body">
        <p>{intro}</p>
        <p class="inet-more-row">{profile.atAGlance[1]}</p>
      </div>
    </section>

    <section class="inet-mod" aria-labelledby="skills-heading">
      <header class="inet-mod__bar inet-mod__bar--metal">
        <h2 id="skills-heading">SKILLS.TXT</h2>
        <span class="inet-mod__meta">{skillLines.length} entries</span>
      </header>
      <div class="inet-mod__body inet-skills-body">
        <ul class="inet-skills">
          {skillLines.map((s) => <li>&gt; {s}</li>)}
        </ul>
      </div>
    </section>

    <section class="inet-mod" aria-labelledby="work-heading">
      <header class="inet-mod__bar inet-mod__bar--work">
        <h2 id="work-heading">SELECTED_WORK</h2>
        <span class="inet-mod__meta">dir / projects</span>
      </header>
      <div class="inet-mod__body inet-work-body">
        {
          selected.map((project, i) => (
            <article
              class:list={["inet-proj", i === 0 ? "inet-proj--a" : "inet-proj--b"]}
            >
              <div class="inet-proj__head">
                <span class="inet-proj__id">
                  [{String(i + 1).padStart(2, "0")}] {project.title.toUpperCase()}
                </span>
                <span class="inet-proj__status" title={project.status}>
                  {statusLabel(project.status)}
                </span>
              </div>
              {i === 0 && project.slug === "origenlab" ? (
                <div class="inet-proj__inner">
                  <img
                    class="inet-px"
                    src="/design-lab/px-lab.svg"
                    width="32"
                    height="32"
                    alt=""
                    aria-hidden="true"
                  />
                  <div class="inet-proj__copy">
                    <p class="inet-proj__stack">{stackLine(project.stack)}</p>
                    <p class="inet-proj__blurb">{listingBlurb(project)}</p>
                    <p>
                      <a class="inet-link" href={`/projects/${project.slug}`}>
                        view_project →
                      </a>
                    </p>
                  </div>
                </div>
              ) : (
                <>
                  <p class="inet-proj__stack">{stackLine(project.stack)}</p>
                  <p class="inet-proj__blurb">{listingBlurb(project)}</p>
                  <p>
                    <a
                      class:list={[
                        "inet-link",
                        i > 0 && "inet-link--visited",
                      ]}
                      href={`/projects/${project.slug}`}
                    >
                      view_project →
                    </a>
                  </p>
                </>
              )}
            </article>
          ))
        }
        <p class="inet-more-row">
          <a class="inet-link" href="/projects">all_projects.html →</a>
        </p>
      </div>
    </section>

    <section class="inet-mod" aria-labelledby="links-heading">
      <header class="inet-mod__bar inet-mod__bar--links">
        <h2 id="links-heading">CONTACT / LINKS</h2>
        <span class="inet-mod__meta">also</span>
      </header>
      <div class="inet-mod__body">
        <p class="inet-also">
          <a class="inet-link" href={profile.contact.github}>github.exe</a>
          ·
          <a class="inet-link" href={profile.contact.linkedIn}>linkedin.url</a>
          ·
          <a class="inet-link" href={`mailto:${profile.contact.email}`}
            >email.exe</a
          >
          ·
          <a class="inet-link" href="/experience">resume.txt</a>
          ·
          <a class="inet-link" href="/about">about.txt</a>
        </p>
      </div>
    </section>
  </PortfolioBrowser>
</BaseLayout>
