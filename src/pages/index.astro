---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SystemDiagram from "@/components/SystemDiagram.astro";
import { profile } from "@/data/profile";
import { projects } from "@/data/projects";

const featured = projects;
const pageTitle = "Rafael Rojas";
const description = profile.bio.slice(0, 155) + "…";
---

<BaseLayout title={pageTitle} description={description}>
  <section
    class="relative mx-auto max-w-6xl px-4 pb-16 pt-12 sm:px-6 sm:pt-16 lg:pt-20"
  >
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.28em] text-accent/90">
          {profile.location}
        </p>
        <h1
          class="mt-4 text-balance text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.25rem]"
        >
          {profile.name}
        </h1>
        <p class="mt-2 text-sm text-ink-muted">
          {profile.pronouns} · {profile.role}
        </p>
        <p
          class="mt-6 font-mono text-sm font-medium uppercase tracking-[0.12em] text-ink-muted"
        >
          {profile.tagline}
        </p>
        <p
          class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-ink-muted"
        >
          {profile.headline}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/projects"
            class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wider text-surface transition hover:bg-ink hover:shadow-glow hover:shadow-accent/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            View projects
          </a>
          <a
            href="/about"
            class="inline-flex items-center justify-center rounded-lg border border-line bg-surface-overlay/50 px-5 py-2.5 font-mono text-sm font-medium uppercase tracking-wider text-ink transition hover:border-accent/35 hover:text-accent"
          >
            Read about me
          </a>
          <a
            href={`mailto:${profile.contact.email}`}
            class="inline-flex items-center justify-center rounded-lg border border-transparent px-5 py-2.5 font-mono text-sm font-medium uppercase tracking-wider text-ink-muted underline-offset-4 transition hover:text-accent hover:underline"
          >
            Contact
          </a>
        </div>
      </div>
      <SystemDiagram variant="hero" class="opacity-95" />
    </div>
  </section>

  <section
    class="mx-auto max-w-6xl border-t border-line/60 px-4 py-16 sm:px-6"
    aria-labelledby="systems-heading"
  >
    <SectionHeading
      id="systems-heading"
      eyebrow="Selected systems"
      title="Projects that behave like infrastructure"
      description="Each build is a response to a real workflow: integrations, validation, reporting, and the quiet work that keeps production calm."
    />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {featured.map((p) => <ProjectCard project={p} featured />)}
    </div>
    <p class="mt-10 text-center">
      <a
        href="/projects"
        class="font-mono text-sm font-medium uppercase tracking-wider text-accent transition hover:text-ink"
      >
        Browse the full project grid →
      </a>
    </p>
  </section>

  <section
    class="mx-auto max-w-6xl px-4 py-16 sm:px-6"
    aria-labelledby="build-heading"
  >
    <SectionHeading
      id="build-heading"
      eyebrow="What I build"
      title="Backend craft with the messiness of the world in mind"
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        profile.pillars.map((pillar) => (
          <div class="rounded-xl border border-line bg-surface-overlay/35 p-5 shadow-card transition hover:border-accent/20">
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-ink-faint">
              Pillar
            </p>
            <h3 class="mt-2 text-base font-semibold text-ink">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              {pillar.body}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div
      class="relative overflow-hidden rounded-2xl border border-line/80 bg-gradient-to-br from-surface-overlay/80 to-surface/90 p-8 sm:p-10"
    >
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-56 w-56 rounded-full bg-accent/10 blur-3xl"
        aria-hidden="true"
      />
      <p class="font-mono text-xs uppercase tracking-[0.24em] text-accent/90">
        Note
      </p>
      <p
        class="relative mt-4 max-w-3xl text-pretty text-lg leading-relaxed text-ink-muted"
      >
        {profile.personalNote}
      </p>
    </div>
  </section>
</BaseLayout>
