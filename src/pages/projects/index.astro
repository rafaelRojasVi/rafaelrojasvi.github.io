---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";

const title = "Projects";
const description =
  "Case studies and systems: automation, APIs, data pipelines, and backend platforms by Rafael Rojas.";
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pt-16">
    <SectionHeading
      eyebrow="Archive"
      title="Project grid"
      description="Each card is a dossier: stack, focus, status, and a longer write-up when you want the architecture story."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</BaseLayout>
