---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseStudyContent from "@/components/CaseStudyContent.astro";
import OrigenLabWebsitePreview from "@/components/origenlab/OrigenLabWebsitePreview.astro";
import OrigenLabEmailPreview from "@/components/origenlab/OrigenLabEmailPreview.astro";
import OrigenLabFlowDiagram from "@/components/origenlab/OrigenLabFlowDiagram.astro";
import OrigenLabOpsStack from "@/components/origenlab/OrigenLabOpsStack.astro";
import OrigenLabApiDemoAccess from "@/components/origenlab/OrigenLabApiDemoAccess.astro";
import { getProjectBySlug } from "@/data/projects";

const project = getProjectBySlug("origenlab")!;
---

<BaseLayout
  title={`${project.title} — Case study`}
  description={project.shortDescription}
>
  <CaseStudyContent
    slug="origenlab"
    insertAfterSectionId="problem"
    clientBranding={{
      href: "https://origenlab.cl",
      name: "OrigenLab",
      animatedMark: "origenlab",
    }}
  >
    <div slot="after-section" class="space-y-12">
      <section
        class="case-study-section scroll-mt-28 rounded-2xl border border-line/80 bg-surface-overlay/20 px-5 py-8 sm:px-8 sm:py-10"
        aria-labelledby="origenlab-scope-heading"
      >
        <h2
          id="origenlab-scope-heading"
          class="text-xl font-semibold tracking-tight text-ink sm:text-2xl"
        >
          Full-stack scope
        </h2>
        <p class="mt-4 max-w-3xl text-pretty leading-relaxed text-ink-muted">
          Production full-stack operations platform for OrigenLab: Astro public
          site, Python email intelligence pipeline, SQLite operational store,
          read-only FastAPI operator API, optional Postgres mirror reporting, and a
          React operator dashboard—four deployable apps in one monorepo, with sensitive
          mail and SQLite living outside git.
        </p>
        <ul class="mt-5 max-w-3xl space-y-2 text-sm leading-relaxed text-ink-muted">
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
            <span><strong class="font-medium text-ink">apps/web</strong> — Astro 5 marketing (origenlab.cl)</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
            <span><strong class="font-medium text-ink">apps/email-pipeline</strong> — ingest, SQLite truth, outbound safety, reports, Streamlit, mutation scripts</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
            <span><strong class="font-medium text-ink">apps/api</strong> — read-only FastAPI on port 8001 (SQLite operator routes; optional mirror reporting via <span class="font-mono text-xs text-accent/90">/mirror/*</span>; typed demo-safe response contracts)</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
            <span><strong class="font-medium text-ink">apps/dashboard</strong> — multi-section React operator dashboard (read-only; human-reviewed outreach)</span>
          </li>
        </ul>
      </section>

      <section
        class="case-study-section scroll-mt-28 rounded-2xl border border-line/80 bg-surface-overlay/20 px-5 py-8 sm:px-8 sm:py-10"
        aria-labelledby="origenlab-why-heading"
      >
        <h2
          id="origenlab-why-heading"
          class="text-xl font-semibold tracking-tight text-ink sm:text-2xl"
        >
          Why this matters
        </h2>
        <p class="mt-4 max-w-3xl text-pretty leading-relaxed text-ink-muted">
          The system turns scattered email history into reviewable commercial
          workflows while keeping sensitive data private and preventing unsafe
          outbound automation. Operators get sanitized previews, mirror reporting
          when Postgres is synced, explicit gates, and documented demo-safe API surfaces—no autonomous send path.
        </p>
      </section>

      <section
        class="case-study-section scroll-mt-28 rounded-2xl border border-line/80 bg-surface-overlay/20 px-5 py-8 sm:px-8 sm:py-10"
        aria-labelledby="origenlab-connected-heading"
      >
        <h2
          id="origenlab-connected-heading"
          class="text-xl font-semibold tracking-tight text-ink sm:text-2xl"
        >
          From public presence to commercial intelligence
        </h2>
        <p class="mt-4 max-w-3xl text-pretty leading-relaxed text-ink-muted">
          A product-forward public site and reusable commercial HTML connect to a
          local-first ops layer: SQLite as operational truth, optional Postgres
          mirror for reporting, read-only FastAPI for the dashboard, Streamlit
          for deep SQLite review, and a React operator dashboard for day-to-day
          triage—always with sanitized previews in this case study.
        </p>

        <div class="mt-10 border-t border-line/60 pt-10">
          <h3 class="text-lg font-semibold text-ink">System surfaces</h3>
          <p class="mt-3 max-w-3xl text-pretty leading-relaxed text-ink-muted">
            Four deployable apps plus shared commercial HTML assets: public
            marketing, email intelligence pipeline, operator API, and dashboard.
            The pipeline connects them through data, safety rules, and
            human-reviewed workflows—not through autonomous sends or API writes.
          </p>
          <p class="mt-3 font-mono text-xs text-ink-faint">
            Live marketing site:{" "}
            <a
              href="https://origenlab.cl"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent transition hover:text-ink"
            >
              origenlab.cl
            </a>
            · Previews below are sanitized mocks (no proprietary HTML pasted in).
          </p>

          <!-- Site first, email below: reading order matches site → campaign asset -->
          <div class="mt-8 flex flex-col gap-10 sm:gap-12">
            <div class="min-w-0">
              <p
                class="mb-2 font-mono text-[10px] uppercase tracking-wider text-ink-faint"
              >
                01 · Public website (mock)
              </p>
              <OrigenLabWebsitePreview />
            </div>
            <div class="relative min-w-0">
              <div
                class="pointer-events-none absolute -top-6 left-1/2 hidden h-6 w-px -translate-x-1/2 bg-gradient-to-b from-accent/40 to-transparent sm:block"
                aria-hidden="true"
              />
              <p
                class="mb-2 font-mono text-[10px] uppercase tracking-wider text-ink-faint"
              >
                02 · Commercial HTML email (mock)
              </p>
              <p class="mb-3 max-w-2xl text-xs leading-relaxed text-ink-muted">
                Same value proposition, packaged for inboxes: table-based layout,
                mobile fallbacks, and dark-mode-safe surfaces.
              </p>
              <div class="mx-auto w-full max-w-[720px]">
                <OrigenLabEmailPreview />
              </div>
            </div>
          </div>

          <div class="mt-10 min-w-0">
            <p
              class="mb-2 font-mono text-[10px] uppercase tracking-wider text-ink-faint"
            >
              03 · Data &amp; safety flow
            </p>
            <OrigenLabFlowDiagram />
          </div>

          <div class="mt-12 min-w-0 border-t border-line/60 pt-12">
            <p
              class="mb-2 font-mono text-[10px] uppercase tracking-wider text-ink-faint"
            >
              04 · Pipeline, Postgres mirror &amp; API
            </p>
            <OrigenLabOpsStack />
          </div>

          <div class="mt-12 min-w-0 border-t border-line/60 pt-12">
            <p
              class="mb-2 font-mono text-[10px] uppercase tracking-wider text-ink-faint"
            >
              05 · API demo, docs &amp; access request
            </p>
            <OrigenLabApiDemoAccess />
          </div>
        </div>
      </section>
    </div>
  </CaseStudyContent>
</BaseLayout>
